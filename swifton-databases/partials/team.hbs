<!-- team.hbs -->
<div class="team-section">
    <h2>Our Team</h2>
    <div class="team-grid">
        <div class="team-member">
        <figure class="member-image">{{> "avatars/default"}}</figure>
        <h3>Ian Smith</h3>
        <p>Founder &amp; Lead Developer</p>
        </div>
        <div class="team-member">
        <figure class="member-image">{{> "avatars/default"}}</figure>
        <h3>Sarah Johnson</h3>
        <p>Database Architect</p>
        </div>
        <div class="team-member">
        <figure class="member-image">{{> "avatars/default"}}</figure>
        <h3>Michael Brown</h3>
        <p>Web Development Lead</p>
        </div>
        <div class="team-member">
        <figure class="member-image">{{> "avatars/default"}}</figure>
        <h3>Emma Wilson</h3>
        <p>Project Manager</p>
        </div>
    </div>
    </div>
<div class="container disable-scrollbar flexy row">
    {{#get "posts" filter="tag:hash-team-member+visibility:public" order="featured desc, published_at asc" limit=6 as |members pages|}}
    {{#foreach members}}<article class="{{post_class}} flexy row shadowed" data-index="{{@index}}" data-play-state="running" title="{{title}}">
        <header class="flexy">
            <h3 id="{{slug}}" title="{{title}}">{{title}}</h3>
            {{#if feature_image}}<figure class="bg-image" style="background-image: url({{img_url feature_image absolute='true'}});">
                <img src="{{img_url feature_image absolute='true'}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" title="{{title}}" loading="lazy" />
                {{#if custom_excerpt}}<figcaption>{{custom_excerpt}}</figcaption>{{/if}}
            </figure>{{/if}}
            {{#has slug="kumar-modi"}}
            <ul class="social-icons flexy row">
                <li class="flexy"><a href="https://www.linkedin.com/in/kmodi9/" title="LinkedIn" target="_blank" rel="noopener"><img src="{{asset 'images/social/linkedin.png'}}" alt="LinkedIn" loading="lazy" /></a></li>
            </ul>
            {{else has slug="gareth-edwards"}}
            <ul class="social-icons flexy row">
                <li class="flexy"><a href="https://www.linkedin.com/in/gareth-edwards-997223a1/" title="LinkedIn" target="_blank" rel="noopener"><img src="{{asset 'images/social/linkedin.png'}}" alt="LinkedIn" loading="lazy" /></a></li>
            </ul>
            {{else has slug="steve-runyeard"}}
            <ul class="social-icons flexy row">
                <li class="flexy"><a href="https://www.linkedin.com/in/steven-runyeard-b8081427/" title="LinkedIn" target="_blank" rel="noopener"><img src="{{asset 'images/social/linkedin.png'}}" alt="LinkedIn" loading="lazy" /></a></li>
            </ul>
            {{else has slug="michael-wood"}}
            <ul class="social-icons flexy row">
                <li class="flexy"><a href="https://www.linkedin.com/in/michael-wood-ab104a204/" title="LinkedIn" target="_blank" rel="noopener"><img src="{{asset 'images/social/linkedin.png'}}" alt="LinkedIn" loading="lazy" /></a></li>
            </ul>
            {{else has slug="salaheddin-abuein"}}
            <ul class="social-icons flexy row">
                <li class="flexy"><a href="https://www.linkedin.com/in/sabuein/" title="LinkedIn" target="_blank" rel="noopener"><img src="{{asset 'images/social/linkedin.png'}}" alt="LinkedIn" loading="lazy" /></a></li>
                <li class="flexy"><a href="https://github.com/sabuein" title="GitHub" target="_blank" rel="noopener" class="flexy">
                    {{> "icons/github-mark"}}
                </a></li>
            </ul>
            {{else has slug="robert-leete"}}
            <ul class="social-icons flexy row">
                <li class="flexy"><a href="https://www.linkedin.com/in/robert-leete/" title="LinkedIn" target="_blank" rel="noopener"><img src="{{asset 'images/social/linkedin.png'}}" alt="LinkedIn" loading="lazy" /></a></li>
            </ul>
            {{/has}}
        </header>
        <div class="flexy">
            {{content words="44"}}
            <a href="{{url}}" title="View profile" type="text/html" class="flexy">View profile</a>
        </div>
    </article>{{/foreach}}
    <pre class="pagination">Found ({{pages.total}}) team members&period;</pre>{{else}}<p class="get-posts-error">{{error}}</p>{{/get}}
</div>