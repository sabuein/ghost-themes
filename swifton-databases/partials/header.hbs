        {{> "icons/swifton-full-logo"}}
    </a></figure>
    {{else}}
    {{!--
    <h1>{{@site.title}}</h1>
    <h2>{{@site.description}}</h2>
    --}}
    <figure class="flexy logo"><a href="{{@site.url}}" title="{{@site.title}}">
        {{> "icons/swifton-full-logo"}}
        {{!-- <img src="{{asset 'images/new-logo.png'}}" alt="{{@site.title}}" loading="lazy" /> --}}
    </a></figure>
    {{/if}}
