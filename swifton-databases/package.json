{
    "name": "swifton-databases",
    "description": "A custom Ghost theme for Swifton Databases Limited",
    "demo": "https://swifton.co.uk/",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=5.116.1"
    },
    "license": "NA",
    "screenshots": {
        "mobile": "assets/screenshot-mobile.jpg",
        "desktop": "assets/screenshot-desktop.jpg"
    },
    "scripts": {
        "link": "ln -s /home/sabuein/my/projects/rapid-is /home/sabuein/my/instances/ghost/content/themes | ls ../../instances/ghost/content/themes/",
        "check": "npx gscan .",
        "start": "ghost start -d C:\\Users\\sala\\my\\ghost-cms",
        "restart": "ghost restart -d ~/my/instances/ghost/",
        "stop": "ghost stop -d ~/my/instances/ghost/",
        "update": "ghost update -d ~/my/instances/ghost/",
        "debug": "ghost run -D -d ~/my/instances/ghost/"
    },
    "author": {
        "name": "Salaheddin AbuEin",
        "email": "salaheddin.abuein@rapid-is.co.uk",
        "url": "https://sabuein.github.io/"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/sabuein/ghost-themes.git"
    },
    "bugs": "https://github.com/sabuein/ghost-themes/issues",
    "contributors": [
        "https://github.com/sabuein/ghost-themes/graphs/contributors"
    ],
    "browserslist": [
        "defaults"
    ],
    "config": {
        "card_assets": true,
        "posts_per_page": 9,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 2000
            }
        }
    },
    "type": "module"
}