{{!< default}}
<!-- page-contact.hbs -->
{{#is "page"}}
{{#post}}
<section class="flexy hero">
    {{#match @page.show_title_and_feature_image}}<hgroup class="flexy hero-content">
        <h1 id="{{slug}}" title="{{title}}">{{title}}</h1>
        <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="51"}}&hellip;{{/if}}</p>
    </hgroup>
    {{#if feature_image}}<figure class="flexy bg-image" style="{{#primary_tag}}{{#if accent_color}}background-color: {{accent_color}}; {{/if}}{{/primary_tag}}background-image: url({{img_url feature_image absolute='true'}})">
        <img src="{{img_url feature_image absolute='true'}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" title="{{title}}" loading="lazy" onerror="this.style.display = 'none';" />
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>{{/if}}{{/match}}
</section>
<section class="container">
  <div class="contact-grid">
      {{> "contact-form"}}
      <div class="contact-info">
        <h2>Contact information</h2>
        <div class="info-item">
          <h3>Phone</h3>
          <p><a href="tel:+441217079008" title="Telephone number" target="_blank" itemprop="telephone">0121 707 9008</a></p>
          <p><a href="tel:+447939134959" title="Mobile number" target="_blank" itemprop="mobile">07939 134 959</a></p>
        </div>
        <div class="info-item">
          <h3>Email</h3>
          <p><a href="mailto:ian@swifton.co.uk&subject={{encode @site.title}}" title="Email address" target="_blank" itemprop="email">ian@swifton&period;co&period;uk</a></p>
        </div>
        <div class="info-item">
          <h3>Office hours</h3>
          <p>Monday &dash; Friday: 9:00 AM &dash; 5:30 PM</p>
          <p>Saturday &dash; Sunday: Closed</p>
        </div>
        <div class="info-item">
          <h3>Follow us</h3>
          <div class="flexy social-links">
            {{> "social-icons"}}
          </div>
        </div>
        {{> "map"}}
      </div>
    <!--div style="height: 40dvh"><script src="https://cdn.jsdelivr.net/ghost/signup-form@~0.1/umd/signup-form.min.js" data-background-color="#ffffff" data-text-color="#000000" data-button-color="#210a99" data-button-text-color="#ffffff" data-title="Rapid Information Systems" data-description="Do more with less" data-icon="https://rapid-is.co.uk/content/images/size/w192h192/size/w256h256/2023/11/rapid-is-icon-29092023.png" data-site="https://rapid-is.co.uk/" async></script></!div-->
    </div>
    <div class="flexy content">
      {{content}}
    </div>
</section>
{{/post}}
{{/is}}