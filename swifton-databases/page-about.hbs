{{!< default}}
<!-- page-about.hbs -->
{{#is "page"}}
{{#post}}
<section class="flexy hero">
    {{#match @page.show_title_and_feature_image}}<hgroup class="flexy hero-content">
        <h1 id="{{slug}}" title="{{title}}">{{title}}</h1>
        <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="51"}}&hellip;{{/if}}</p>
    </hgroup>
    {{#if feature_image}}<figure class="flexy bg-image" style="{{#primary_tag}}{{#if accent_color}}background-color: {{accent_color}}; {{/if}}{{/primary_tag}}background-image: url({{img_url feature_image absolute='true'}})">
        <img src="{{img_url feature_image absolute='true'}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" title="{{title}}" loading="lazy" onerror="this.style.display = 'none';" />
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>{{/if}}{{/match}}
</section>
<section class="flexy about-content">
    <div class="flexy content">
      {{content}}
    </div>
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <h2 class="section-title">Who We Are</h2>
          <p>We provide software solutions for businesses, charities and local authorities. We specialise in database-driven applications to help organisations manage their data, business processes and workflow. We use a range of programming tools to deliver high-quality, user&dash;friendly applications for both the Windows platform and for websites.</p>
          
          <h2 class="section-title">Our Experience</h2>
          <p>We have over 25 years&apos; experience in the development of bespoke software applications, with clients ranging from large multinationals to smaller owner&dash;managed businesses&period;</p>
          
          <h2 class="section-title">Our Approach</h2>
          <p>We believe in creating software that not only meets your technical requirements but is also intuitive and user&dash;friendly&period; Our development process involves close collaboration with clients to ensure we deliver solutions that truly address your business needs.</p>

          <h2 class="section-title">Open Source Technologies</h2>
          <p>We use open source tools to enhance security&comma; transparency&comma; and flexibility&period; Our solutions are built with trusted open&dash;source technologies like &period;NET&comma; which provide customers with a wide range of integration options and community&dash;driven improvements&period; Leveraging open source frameworks allows us to avoid vendor lock&dash;in and gives customers more confidence in the long&dash;term viability of our solutions&period;</p>
        </div>
        <div class="about-image">
          <div class="image-placeholder">
            <div class="abstract-shape"></div>
          </div>
        </div>
      </div>
      
      <div class="timeline">
        <h2 class="section-title">Our Journey</h2>
        <div class="timeline-items">
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h3>2000</h3>
              <p>Swifton Databases Limited was founded&period;</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h3>2005</h3>
              <p>Expanded services to include web applications&period;</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h3>2010</h3>
              <p>Reached milestone of 50 successful client projects&period;</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h3>2015</h3>
              <p>Introduced legacy system migration services&period;</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h3>2020</h3>
              <p>Celebrating 20 years of delivering database solutions&period;</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h3>2025</h3>
              <p>Swifton Databases Limited joins the <strong><a href="https://rapid-is.co.uk/" title="Rapid Information Systems" target="_blank">Rapid Information Systems</a></strong> family&comma; marking a new chapter after 25 years of delivering trusted database solutions&period;</p>
            </div>
          </div>
        </div>
      </div>
      {{> "team"}}
    </div>
</section>
{{/post}}
{{/is}}