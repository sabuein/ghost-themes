{{!< default}} <!-- page-about.hbs -->
  {{#is "page"}}
  {{#post}}
  <section class="flexy hero">
    {{#match @page.show_title_and_feature_image}}<hgroup class="flexy hero-content">
      <h1 id="{{slug}}" title="{{title}}">{{title}}</h1>
      <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="51"}}{{/if}}</p>
    </hgroup>
    {{#if feature_image}}<figure class="flexy bg-image"
      style="{{#primary_tag}}{{#if accent_color}}background-color: {{accent_color}}; {{/if}}{{/primary_tag}}background-image: url({{img_url feature_image absolute='true'}})">
      <img src="{{img_url feature_image absolute='true'}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" title="{{title}}" loading="lazy"
        onerror="this.style.display = 'none';" />
      {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>{{/if}}{{/match}}
  </section>
  
  <section class="flexy capabilities">
  <div class="container">
    <h2 class="section-title">Our solutions</h2>
    
    <!-- Desktop version -->
    <div class="capabilities-grid">
      <!-- Quotation & Sales Systems -->
      <div class="capability-card">
        <div class="capability-header">
          <span class="capability-icon">🧾</span>
          <h3>Quotation &amp; Sales Systems</h3>
        </div>
        <p>Custom-built tools to manage complex quotations, multi-tiered pricing, and sales workflows.</p>
        <div class="features">
          <h4>Features:</h4>
          <ul>
            <li>Multi-template support</li>
            <li>Integrated site survey tools</li>
            <li>CRM-like contact management</li>
            <li>Document generation &amp; history tracking</li>
          </ul>
        </div>
      </div>

      <!-- Field Service & Installation Support Tools -->
      <div class="capability-card">
        <div class="capability-header">
          <span class="capability-icon">🛠</span>
          <h3>Field Service &amp; Installation Support Tools</h3>
        </div>
        <p>Software for scheduling, tracking, and supporting installation and service jobs.</p>
        <div class="features">
          <h4>Features:</h4>
          <ul>
            <li>Engineer service logs (tablet integration)</li>
            <li>On-site image libraries</li>
            <li>Installation feasibility checklists</li>
            <li>Service history tracking</li>
            <li>Safety &amp; Compliance (e.g.COSHH Assessments)</li>
          </ul>
        </div>
      </div>

      <!-- Workforce & Recruitment Management -->
      <div class="capability-card">
        <div class="capability-header">
          <span class="capability-icon">🧑‍💼</span>
          <h3>Workforce &amp; Recruitment Management</h3>
        </div>
        <p>Streamline agency and temp worker management with tools for job processing, CSV uploads, and verification.</p>
        <div class="features">
          <h4>Features:</h4>
          <ul>
            <li>CSV job post imports</li>
            <li>Identity verification integrations (e.g., YoTi)</li>
            <li>Remote desktop support</li>
            <li>Messaging and communication modules</li>
          </ul>
        </div>
      </div>

      <!-- Business Intelligence & Reporting Dashboards -->
      <div class="capability-card">
        <div class="capability-header">
          <span class="capability-icon">📊</span>
          <h3>Business Intelligence &amp; Reporting Dashboards</h3>
        </div>
        <p>Integrated BI tools with real-time dashboards for sales, performance tracking, and reporting.</p>
        <div class="features">
          <h4>Features:</h4>
          <ul>
            <li>Sales targets &amp; metrics</li>
            <li>Custom reports linked to ERP systems</li>
            <li>Support time tracking</li>
          </ul>
        </div>
      </div>

      <!-- ERP Integration Services -->
      <div class="capability-card">
        <div class="capability-header">
          <span class="capability-icon">📦</span>
          <h3>ERP Integration Services</h3>
        </div>
        <p>Seamless integrations with ERP systems like Sage 200, Opera, and Dynamics.</p>
        <div class="features">
          <h4>Features:</h4>
          <ul>
            <li>API development</li>
            <li>Custom reporting layers</li>
            <li>Data sync across finance, sales, and operations</li>
          </ul>
        </div>
      </div>

      <!-- Legacy System Modernisation -->
      <div class="capability-card">
        <div class="capability-header">
          <span class="capability-icon">🌐</span>
          <h3>Legacy System Modernisation</h3>
        </div>
        <p>Turn ageing desktop applications into accessible web-based solutions.</p>
        <div class="features">
          <h4>Features:</h4>
          <ul>
            <li>Full system redevelopments in modern frameworks</li>
            <li>Web and mobile responsive access</li>
            <li>Secure cloud-based hosting options</li>
          </ul>
        </div>
      </div>
      
      <!-- Custom CRM Solutions -->
      <div class="capability-card">
        <div class="capability-header">
          <span class="capability-icon">🧩</span>
          <h3>Custom CRM Solutions</h3>
        </div>
        <p>Tailored CRM-style systems with modular functionality to support sales, marketing, and customer service.</p>
        <div class="features">
          <h4>Features:</h4>
          <ul>
            <li>Lead and contact tracking</li>
            <li>Marketing data exports</li>
            <li>Document and task workflows</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Mobile accordion version -->
    <div class="accordion" id="capabilities-accordion">
      <!-- JavaScript will populate this -->
    </div>
  </div>
</section>

  <section class="flexy process">
    <div class="container">
      <h2 class="section-title">Our Development Process</h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">1</div>
          <h3>Discovery</h3>
          <p>We work with you to understand your business needs, current systems, and goals for the new solution.</p>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <h3>Planning</h3>
          <p>We create detailed specifications and project plans, ensuring all requirements are captured.</p>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <h3>Development</h3>
          <p>Our team builds your solution using industry best practices and regular client feedback.</p>
        </div>
        <div class="process-step">
          <div class="step-number">4</div>
          <h3>Testing</h3>
          <p>Rigorous testing ensures your solution is robust, secure, and meets all requirements.</p>
        </div>
        <div class="process-step">
          <div class="step-number">5</div>
          <h3>Deployment</h3>
          <p>We carefully manage the transition to your new system, including data migration and training.</p>
        </div>
        <div class="process-step">
          <div class="step-number">6</div>
          <h3>Support</h3>
          <p>Ongoing support and maintenance ensures your solution continues to meet your needs.</p>
        </div>
      </div>
    </div>
  </section>
  {{> "cta-contact"}}
  {{/post}}
  {{/is}}