{{!< default}}
<!-- page-about.hbs -->
{{#is "page"}}
{{#post}}
<section class="flexy hero">
    {{#match @page.show_title_and_feature_image}}<hgroup class="flexy hero-content">
        <h1 id="{{slug}}" title="{{title}}">{{title}}</h1>
        <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="51"}}{{/if}}</p>
    </hgroup>
    {{#if feature_image}}<figure class="flexy bg-image" style="{{#primary_tag}}{{#if accent_color}}background-color: {{accent_color}}; {{/if}}{{/primary_tag}}background-image: url({{img_url feature_image absolute='true'}})">
        <img src="{{img_url feature_image absolute='true'}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" title="{{title}}" loading="lazy" onerror="this.style.display = 'none';" />
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>{{/if}}{{/match}}
</section>
    <section class="flexy capabilities">
        <div class="container">
            <h2 class="section-title">Key capabilities</h2>
            <div class="capabilities-grid">
                <div class="capability-card">
                    <h3>Custom Business Applications</h3>
                    <p>Including order processing systems, delivery tracking, inspection tools, quotation management, and dashboard reporting. We work closely with departments like Sales, Operations, and Manufacturing to align the tools with their needs.</p>
                </div>
                
                <div class="capability-card">
                    <h3>Systems Integration</h3>
                    <p>Seamless API integrations with platforms such as Sage 200, order management systems, identity verification tools (e.g., YoTi), and remote desktop environments.</p>
                </div>
                
                <div class="capability-card">
                    <h3>Manufacturing & Engineering Tools</h3>
                    <p>Critical systems including web applications for manufacturing operations, PCB printing workflows, inspection automation, and drawing/data management.</p>
                </div>
                
                <div class="capability-card">
                    <h3>Recruitment & Workforce Solutions</h3>
                    <p>Platforms for managing temporary and agency staff, identity checking, job posting via CSV uploads, and communication via SMS integration.</p>
                </div>
                
                <div class="capability-card">
                    <h3>Legacy System Support & Modernisation</h3>
                    <p>Support for long-standing desktop applications (e.g., 15+ years old), including updates, maintenance, remote access setups, and performance enhancements.</p>
                </div>
                
                <div class="capability-card">
                    <h3>Ongoing Support & Maintenance</h3>
                    <p>Dedicated support arrangements for clients with monthly service models, ensuring continuous system performance and adaptability.</p>
                </div>
            </div>
            
            <!-- Mobile accordion version -->
            <div class="accordion" id="capabilities-accordion">
                <!-- JavaScript will populate this -->
            </div>
        </div>
    </section>
<section class="flexy process">
    <div class="container">
      <h2 class="section-title">Our Development Process</h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">1</div>
          <h3>Discovery</h3>
          <p>We work with you to understand your business needs, current systems, and goals for the new solution.</p>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <h3>Planning</h3>
          <p>We create detailed specifications and project plans, ensuring all requirements are captured.</p>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <h3>Development</h3>
          <p>Our team builds your solution using industry best practices and regular client feedback.</p>
        </div>
        <div class="process-step">
          <div class="step-number">4</div>
          <h3>Testing</h3>
          <p>Rigorous testing ensures your solution is robust, secure, and meets all requirements.</p>
        </div>
        <div class="process-step">
          <div class="step-number">5</div>
          <h3>Deployment</h3>
          <p>We carefully manage the transition to your new system, including data migration and training.</p>
        </div>
        <div class="process-step">
          <div class="step-number">6</div>
          <h3>Support</h3>
          <p>Ongoing support and maintenance ensures your solution continues to meet your needs.</p>
        </div>
      </div>
    </div>
  </section>
  {{> "cta-contact"}}
{{/post}}
{{/is}}