  <section class="flexy hero">
    <div class="container">
      <div class="flexy hero-content">
        <h1>Digital solutions for your business</h1>
        <p>Over 20 years of experience delivering high-quality&comma; user&dash;friendly applications for Windows and
          web platforms&period;</p>
        <div class="hero-buttons">
          <a href="/solutions" class="btn primary" title="Our solutions">Our solutions</a>
          <a href="/contact" class="btn secondary" title="Get in touch">Get in touch</a>
        </div>
      </div>
      <div class="hero-image">
        <div class="image-placeholder">
          <div class="abstract-shape"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="flexy services">
    <div class="container">
      <h2 class="section-title">Our Expertise</h2>
      <div class="service-cards">
        <div class="card" tabindex="0">
          <div class="card-icon windows-icon"></div>
          <h3>Windows Applications</h3>
          <p>Functional&comma; secure and robust Windows applications using C# and Visual Basic&period;</p>
        </div>
        <div class="card" tabindex="0">
          <div class="card-icon web-icon"></div>
          <h3>Web Applications</h3>
          <p>Interactive&comma; data-driven websites and intranet solutions using the latest ASP&period;NET
            technologies&period;</p>
        </div>
        <div class="card" tabindex="0">
          <div class="card-icon legacy-icon"></div>
          <h3>Legacy Systems</h3>
          <p>Expertise in migrating from legacy systems to modern technologies with minimal disruption&period;</p>
        </div>
      </div>
    </div>
  </section>
  {{> "cta-contact"}}
  {{> "subscribe"}}
  {{/is}}