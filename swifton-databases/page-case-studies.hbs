{{!< default}} <!-- page-about.hbs -->
  {{#is "page"}}
  {{#post}}
  <!-- Font Awesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <section class="flexy hero">
    {{#match @page.show_title_and_feature_image}}<hgroup class="flexy hero-content">
      <h1 id="{{slug}}" title="{{title}}">{{title}}</h1>
      <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="51"}}{{/if}}</p>
    </hgroup>
    {{#if feature_image}}<figure class="flexy bg-image"
      style="{{#primary_tag}}{{#if accent_color}}background-color: {{accent_color}}; {{/if}}{{/primary_tag}}background-image: url({{img_url feature_image absolute='true'}})">
      <img src="{{img_url feature_image absolute='true'}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" title="{{title}}" loading="lazy"
        onerror="this.style.display = 'none';" />
      {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>{{/if}}{{/match}}
  </section>
  <section class="flexy case-studies">
    <div class="flexy content">
      {{content}}
    </div>
    <div class="flexy container tabs-container">
      <div class="tabs-list">
        <button class="tab-trigger active" data-tab="resource-management">
          <i class="fas fa-chart-bar"></i>
          <span class="tab-text-full">Resource Management</span>
          <span class="tab-text-short">Resources</span>
        </button>
        <button class="tab-trigger" data-tab="sales-crm">
          <i class="fas fa-building"></i>
          <span class="tab-text-full">Sales &amp; CRM</span>
          <span class="tab-text-short">Sales</span>
        </button>
        <button class="tab-trigger" data-tab="safety">
          <i class="fas fa-hard-hat"></i>
          <span class="tab-text-full">Safety</span>
          <span class="tab-text-short">Safety</span>
        </button>
        <button class="tab-trigger" data-tab="automated-processes">
          <i class="fas fa-cogs"></i>
          <span class="tab-text-full">Automated Processes</span>
          <span class="tab-text-short">Automation</span>
        </button>
      </div>

      <div class="tab-content active" id="resource-management">
        <div class="category-header">
          <div class="category-icon">
            <i class="fas fa-chart-bar"></i>
          </div>
          <h3 class="section-title">Resource management</h3>
          <p>Optimising resource allocation and utilisation across organisations&period;</p>
        </div>

        <div class="flexy case-studies-grid">
          <div class="flexy case-study-card">
            <div class="case-study-image">
              <img src="https://placehold.co/600x400" alt="Manufacturing Efficiency Improvement">
            </div>
            <div class="card-header">
              <h4>Manufacturing Efficiency Improvement</h4>
            </div>
            <div class="card-content">
              <p>Helped a manufacturing company reduce resource waste by 35% through advanced analytics and optimisation
                algorithms&period;</p>
            </div>
            <div class="card-footer">
              <a href="#" class="read-more-btn">
                Read Case Study
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="flexy case-study-card">
            <div class="case-study-image">
              <img src="https://placehold.co/600x400" alt="Energy Sector Resource Optimisation">
            </div>
            <div class="card-header">
              <h4>Energy Sector Resource Optimisation</h4>
            </div>
            <div class="card-content">
              <p>Implemented a resource management system that improved operational efficiency by 28% for a major energy
                provider.</p>
            </div>
            <div class="card-footer">
              <a href="#" class="read-more-btn">
                Read Case Study
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="flexy case-study-card">
            <div class="case-study-image">
              <img src="https://placehold.co/600x400" alt="Supply Chain Transformation">
            </div>
            <div class="card-header">
              <h4>Supply Chain Transformation</h4>
            </div>
            <div class="card-content">
              <p>Redesigned supply chain processes resulted in a 22% cost reduction and improved resource
                allocation&period;</p>
            </div>
            <div class="card-footer">
              <a href="#" class="read-more-btn">
                Read Case Study
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>

        <div class="view-all-container">
          <a href="#" class="view-all-btn">View All Resource Management Case Studies</a>
        </div>
      </div>

      <div class="tab-content" id="sales-crm">
        <div class="category-header">
          <div class="category-icon">
            <i class="fas fa-building"></i>
          </div>
          <h3 class="section-title">Sales &amp; CRM</h3>
