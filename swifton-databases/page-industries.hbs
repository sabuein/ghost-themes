{{!< default}} <!-- page-industries.hbs -->
  {{#is "page"}}
  {{#post}}
  <section class="flexy industries">
    <div class="flexy container">
      {{#match @page.show_title_and_feature_image}}<hgroup class="flexy">
        <h1 id="{{slug}}" title="{{title}}" class="section-title">{{title}}</h1><!-- Industries We Serve -->
        <p class="section-subtitle">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="51"}}{{/if}}</p>
      </hgroup>
      {{#if feature_image}}<figure class="flexy bg-image"
        style="{{#primary_tag}}{{#if accent_color}}background-color: {{accent_color}}; {{/if}}{{/primary_tag}}background-image: url({{img_url feature_image absolute='true'}})">
        <img src="{{img_url feature_image absolute='true'}}"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" title="{{title}}" loading="lazy"
          onerror="this.style.display = 'none';" />
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
      </figure>{{/if}}{{/match}}
      <div class="industry-grid">
        <div class="industry-card" tabindex="0">
          <div class="industry-icon">🛳️</div>
          <h3 class="industry-title">Maritime &amp; Marine Coatings</h3>
          <p class="industry-subtitle">Supporting shipowners, coating manufacturers, and research teams with marine
            protection systems.</p>
          <p class="industry-description">We develop systems used in maritime protective coatings. These include
            solutions for vessel coating assessments, antifouling research, and marine paint trials, serving global
            manufacturers and shipowners.</p>
        </div>

        <div class="industry-card" tabindex="0">
          <div class="industry-icon">🧪</div>
          <h3 class="industry-title">Chemical &amp; Health Safety</h3>
          <p class="industry-subtitle">Systems for chemical inventory, hazard tracking, and lab safety — trusted by
            global labs and corporations.</p>
          <p class="industry-description">Supporting global chemical inventory systems, including tools for hazard
            identification, COSHH assessments, and batch management. Used by laboratories and multinational corporations
            in compliance-critical environments.</p>
        </div>

        <div class="industry-card" tabindex="0">
          <div class="industry-icon">🐖</div>
          <h3 class="industry-title">Agriculture &amp; Animal Nutrition</h3>
          <p class="industry-subtitle">Digital tools for animal feed producers and livestock data analysis, focused on
            health and performance.</p>
          <p class="industry-description">Specialists in systems for medicated animal feed producers. From sales
            ordering and data visualisation to slaughter analytics, we support businesses focused on livestock
            performance and nutrition science.</p>
        </div>

        <div class="industry-card" tabindex="0">
          <div class="industry-icon">🧱</div>
          <h3 class="industry-title">Industrial &amp; Protective Coatings</h3>
          <p class="industry-subtitle">Fire protection, steel treatment, and industrial coating systems to meet
            compliance and performance needs.</p>
          <p class="industry-description">From fire protection coatings to steel treatments, we've supported technical
            and sales systems for specialist industrial coatings, helping streamline processes and product compliance.
          </p>
        </div>

        <div class="industry-card" tabindex="0">
          <div class="industry-icon">🍖</div>
          <h3 class="industry-title">Food Supply Chain &amp; Meat Processing</h3>
          <p class="industry-subtitle">Sales, invoicing, and carcass analysis tools for pork producers and processors.
          </p>
          <p class="industry-description">We provide tailored software for sales order processing, invoicing, and
            carcass data analysis in the pork supply chain. Our systems help optimise farm-to-market operations, with
            tools for fat scoring, dead weight tracking, and performance visualisation.</p>
        </div>

        <div class="industry-card" tabindex="0">
          <div class="industry-icon">📊</div>
          <h3 class="industry-title">Data Integration &amp; Visualisation</h3>
          <p class="industry-subtitle">We transform complex data into intuitive dashboards and reports, supporting
            decision-making across industries.</p>
          <p class="industry-description">Across all industries, we build and support systems for complex data import,
            visualisation, and reporting — converting raw data into actionable insights via custom dashboards and
            interfaces.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="flexy industries">
    <div class="flexy content">
      {{content}}
    </div>
  </section>
  {{> "cta-contact"}}
  {{/post}}
  {{/is}}