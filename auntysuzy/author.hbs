{{!< default}}

<div class="ae-page">
    <div class="ae-container">

        {{#author}}
        <header class="ae-page-head">
            {{#if profile_image}}
                <img class="gh-author-image" src="{{profile_image}}" alt="{{name}}" />
            {{/if}}

            <h1>{{name}}</h1>
            {{#if bio}}
                <p>{{bio}}</p>
            {{/if}}

            <div class="gh-author-meta">
                <p>{{plural ../pagination.total empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}}</p>
                <div class="gh-author-links">
                    {{#if website}}
                        <a href="{{website}}?ref={{@site.url}}" title="Website" target="_blank" rel="nofollow noopener">Website</a>
                    {{/if}}
                    {{#if twitter}}
                        <a href="{{social_url type="twitter"}}?ref={{@site.url}}" title="Twitter" target="_blank" rel="nofollow noopener">Twitter</a>
                    {{/if}}
                    {{#if facebook}}
                        <a href="{{social_url type="facebook"}}?ref={{@site.url}}" title="Facebook" target="_blank" rel="nofollow noopener">Facebook</a>
                    {{/if}}
                </div>
            </div>

            {{#if cover_image}}
                <img class="ae-page-image" src="{{cover_image}}" alt="{{name}}" />
            {{/if}}
        </header>
        {{/author}}

        <div class="gh-postfeed">
        {{#foreach posts}}

            {{> "card"}} {{!-- partials/card.hbs --}}

        {{/foreach}}{{pagination}}
        </div>

    </div>
</div>