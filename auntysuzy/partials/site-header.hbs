<!-- site-header.hbs -->
<header>
    <div class="brand-container">
        {{#if @site.logo}}<figure class="logo" >
            <a href="{{@site.url}}" title="{{@site.title}} &mdash; {{@site.description}}" target="_top"><img src="{{@site.logo}}" alt="{{@site.title}}" /></a>
        </figure>{{else}}<hgroup class="logo">
            <h1>{{@site.title}}</h1>
            <p>{{@site.description}}</p>
        </hgroup>{{/if}}
        {{navigation}}
    </div>
</header>