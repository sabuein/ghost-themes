<!-- header.hbs -->
<header>
    <div class="brand-container">
        <hgroup>
            <h1>{{@site.title}}</h1>
            <p>{{@site.description}}</p>
        </hgroup>
        <figure class="logo-container">
            <a href="{{@site.url}}" title="{{@site.title}} &mdash; {{@site.description}}" target="_top"><figure class="logo">
                <img src="{{@site.logo}}" alt="{{@site.title}}" />
            </figure>
            </a>
        </figure>
        {{navigation}}
    </div>
</header>