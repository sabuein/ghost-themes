<!-- newsletter.hbs -->
{{^if @member}}{{#unless @site.members_invite_only}}<section class="newsletter-section flexy column">
    <hgroup class="flexy column">
        <h3>Join our community</h3>
        <p>Sign up to receive early access to new handmade pieces, members-only offers, behind-the-scenes stories, and special announcements.</p>
    </hgroup>
    {{!-- Sign-in form send a magic link to the member's email address and include a one-time code option. --}}
    <form class="newsletter-form flexy column" data-members-form="subscribe" data-members-otc="true" data-members-autoredirect="false">
        <input type="hidden" value="Early Adopters" data-members-label="" />
        <input type="text" id="userName" name="name" placeholder="Enter your name&hellip;" required="required"  autocomplete="name" aria-label="Full name for account" data-members-name=""/>
        <input type="email" id="userEmail" name="name" placeholder="Enter your email&hellip;" required="required" autocomplete="email" aria-label="Email address for account" data-members-email="" />
        {{#get "newsletters"}}<div class="flexy">
            {{#foreach newsletters}}<label><input type="checkbox" value="{{name}}" checked="checked" data-members-newsletter="" />{{name}}</label>{{/foreach}}
        </div>{{/get}}
        <input type="submit" value="{{t "Subscribe"}}" />
        <p data-members-error=""><!-- error message will appear here --></p>
    </form>
    <p class="newsletter-privacy" style="font-size: 11px; margin-top: 10px;">We respect your privacy. Unsubscribe anytime.</p>
</section>{{/unless}}{{/if}}