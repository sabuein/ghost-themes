<!-- newsletter.hbs -->
<div class="newsletter-section">
    <h3>Join Our Community</h3>
    <p>Get exclusive updates on new handmade creations, special offers, and artisan stories delivered to your inbox.</p>
    <form class="newsletter-form" onsubmit="handleNewsletterSubmit(event)">
        <input 
            type="email" 
            placeholder="Your email address" 
            required="required"
            aria-label="Email address for newsletter"
        >
        <button type="submit" title="Subscribe">Subscribe</button>
    </form>
    <p class="newsletter-privacy" style="font-size: 11px; margin-top: 10px;">
        We respect your privacy. Unsubscribe at any time.
    </p>
</div>

<script>
    function handleNewsletterSubmit(event) {
        event.preventDefault();
        const email = event.target.querySelector('input[type="email"]').value;
        console.log('Newsletter signup for:', email);
        alert('Thank you for subscribing! Check your email for a special welcome offer.');
        event.target.reset();
    }
</script>