<!-- navigation.hbs -->
{{#if isSecondary}}<ul class="footer-links-bottom" role="menu">
    {{#foreach navigation}}<li class="nav-{{slug}}{{#if current}} nav-current{{/if}}" role="menuitem">
        <a href="{{url absolute="true"}}" title="{{label}}">{{label}}</a>
    </li>{{/foreach}}
</ul>{{else}}<nav class="desktop-nav">
    <ul class="nav" role="menu">
        {{#foreach navigation}}<li class="{{link_class for=(url) class=(concat "nav-" slug)}}" role="menuitem">
            <a href="{{url absolute="true"}}" title="{{label}}">{{label}}</a>
        </li>{{/foreach}}
    </ul>
    <ul class="nav" role="menu">
        <li role="menuitem"><a href="#/portal/account" title="Account" data-portal="account">{{> "icons/avatar"}}</a></li>
        <li role="menuitem"><a href="javascript:void(0);" class="gh-search" title="Search" data-ghost-search="">{{> "icons/magnifying-glass"}}</a></li>
        <li class="snipcart-summary" role="menuitem"><button class="btn snipcart-checkout" title="Cart summary"><span>Cart</span><span class="snipcart-items-count">&nbsp;</span>{{> "icons/shopping-cart"}}</button></li>
    </ul>
</nav>{{/if}}