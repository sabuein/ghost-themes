<!-- navigation.hbs -->
{{#if isSecondary}}<ul class="footer-links-bottom" role="menu">
    {{#foreach navigation}}<li class="nav-{{slug}}{{#if current}} nav-current{{/if}}" role="menuitem">
        <a href="{{url absolute="true"}}" title="{{label}}">{{label}}</a>
    </li>{{/foreach}}
</ul>{{else}}<nav class="desktop-nav">
    <ul class="nav" role="menu">
        {{#foreach navigation}}<li class="{{link_class for=(url) class=(concat "nav-" slug)}}" role="menuitem">
            <a href="{{url absolute="true"}}" title="{{label}}">{{label}}</a>
        </li>{{/foreach}}
        <li class="snipcart-summary" role="menuitem">
            <a href="#/cart" class="snipcart-checkout" title="Cart summary"><span class="snipcart-items-icon">🛒</span><span class="snipcart-items-count">&nbsp;</span></a>
        </li>
    </ul>
</nav>{{/if}}