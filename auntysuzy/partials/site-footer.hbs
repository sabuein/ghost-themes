<!-- site-footer.hbs -->
<footer class="flexy column">
	<div class="footer-content">
		<div class="footer-sections">
			<div class="footer-section">
				<h3>SHOP</h3>
				<ul>
					<li><a href="/all-products/">All Products</a></li>
					<li><a href="/tag/food/">Food & Pickles</a></li>
					<li><a href="/tag/art/">Art</a></li>
					<li><a href="/tag/handicrafts/">Handicrafts</a></li>
				</ul>
			</div>
			<div class="footer-section">
				<h3>BLOG</h3>
				<ul>
					<li><a href="/blog/">All Posts</a></li>
					<li><a href="/tag/recipes/">Recipes</a></li>
					<li><a href="/tag/crafts/">Crafts</a></li>
					<li><a href="/tag/wellness/">Wellness</a></li>
				</ul>
			</div>
			<div class="footer-section">
				<h3>INFORMATION</h3>
				<ul>
					<li><a href="/about/">About</a></li>
					{{#if @member}}<li><a href="/account/">Account</a></li>{{/if}}
					<li><a href="/support/">Support</a></li>
					{{#if @member}}<li><a href="javascript:void(0);" title="Sign out" data-members-signout="">Sign out</a></li>{{else}}<li><a href="#/portal/signin" title="Sign in" data-portal="signin">Sign in</a></li>
					<li><a href="#/portal/signup" title="Sign up" data-portal="signup">Sign up</a></li>{{/if}}
				</ul>
			</div>
			<div class="footer-section">
				<h3>CONNECT</h3>
				<ul class="flexy">
					{{#if @site.facebook}}<li><a href="https://www.facebook.com/{{@site.facebook}}?ref={{@site.url}}" title="Facebook" target="_blank" rel="nofollow noopener">{{> "icons/facebook"}}</a></li>{{/if}}
					{{#if @site.twitter}}<li><a href="https://x.com/{{@site.twitter}}?ref={{@site.url}}" title="X" target="_blank" rel="nofollow noopener">{{> "icons/x"}}</a></li>{{/if}}
					<li><a href="https://www.instagram.com/auntysuzyuk/?ref={{@site.url}}" title="Instagram" target="_blank" rel="nofollow noopener">{{> "icons/instagram"}}</a></li>
					<li><a href="https://feedly.com/i/subscription/feed/{{@site.url}}/rss/" title="RSS" target="_blank" rel="nofollow noopener">{{> "icons/rss"}}</a></li>
					<li><a href="{{@site.url}}/sitemap.xml" title="XML Sitemap" target="_blank" rel="nofollow noopener">{{> "icons/xml"}}</a></li>
				</ul>
			</div>
		</div>
		<div class="footer-divider"></div>
		<div class="footer-bottom">
			<p>&copy; 2016 &mdash; {{date format="YYYY"}} {{@site.title}}&period; All rights reserved&period;</p>
			{{navigation type="secondary"}}
			<p style="text-align: center; margin-top: 1.5rem;">Designed by <a href="https://abuein.dev/contact/?ref={{@site.url}}" title="AbuEin Technologies" target="_blank" rel="nofollow noopener">AbuEin Technologies</a>&mdash; Powered by <a href="https://ghost.org/experts/salaheddin-abuein/?ref={{@site.url}}" title="Ghost" target="_blank" rel="nofollow noopener">Ghost</a>&period;</p>
			<p>(Total members: <span>{{total_members}}</span>&comma; Paid members: <span>{{total_paid_members}}</span>)</p>
			<a href="#top" class="flexy column" title="Back to top">{{> "icons/arrow-up"}}<span>Back to top</span></a>
		</div>
			
	</div>
</footer>