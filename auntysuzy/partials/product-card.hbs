<!-- product-card.hbs -->
{{#foreach posts}}<article class="product-card" role="group" aria-labelledby="pc-title-1" data-product-id="MKD-OKR-250">
  <div class="pc-media" aria-hidden="false">
{{!-- This is a responsive image, it loads different sizes depending on device
        https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433 --}}
    {{#if feature_image}}<picture>
      <!-- WebP preferred for browsers that support it -->
      <source type="image/webp" srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w,
                    {{img_url feature_image size="xl"}} 2000w" sizes="(max-width:420px) 100vw, 320px">
      <!-- Fallback JPEG/PNG -->
      <img class="pc-image" loading="lazy" decoding="async"
           src="{{img_url feature_image size="m"}}"
           srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w,
                    {{img_url feature_image size="xl"}} 2000w"
           sizes="(max-width:420px) 100vw, 320px"
           alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    </picture>{{/if}}

    <div class="pc-placeholder" aria-hidden="true"></div>

    {{#if featured}}<span class="pc-badge">Scrummy</span>{{/if}}
    <button class="pc-fav" aria-label="Add Makdous Okra to wishlist" title="Add to wishlist">♡</button>
  </div>

  <div class="pc-body">
    <h3 id="pc-title-1" class="pc-title">{{title}}</h3>
    <p class="pc-sub">{{excerpt}}</p>

    <div class="pc-meta">
      <div class="pc-price">
        <span class="pc-price-current" data-price="9.5">$9.50</span>
        <span class="pc-price-unit">/ item</span>
      </div>

      <div class="pc-rating" aria-label="4.6 out of 5 stars" title="4.6">
        <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star dim">★</span>
      </div>
    </div>

    <div class="pc-actions">
      {{!-- Snipcart Products Documentation: https://docs.snipcart.com/v3/setup/products --}}
      <button class="btn pc-add snipcart-add-item" type="button" title="Add to cart" data-item-id="{{id}}" data-item-name="{{title}}" data-item-image="{{img_url feature_image}}" data-item-description="{{excerpt}}" data-item-url="{{url absolute='true'}}" data-item-price="4.50" data-item-custom1-name="Container Type" data-item-custom1-options="Jar" data-item-weight="430">Add to cart</button>
      <a href="{{url}}" title="Learn more"><button class="btn pc-learn" type="button" aria-label="Learn more">Learn more</button></a>
    </div>

    {{#if tags}}<div class="pc-tags">
        <h4>Product tags / keywords</h4>
        {{tags}}
    </div>{{/if}}
  </div>
</article>{{/foreach}}