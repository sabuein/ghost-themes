        <div class="cta-link-wrapper">
            <a href="https://www.instagram.com/auntysuzyuk/?ref={{@site.url}}" title="Instagram" target="_blank" rel="nofollow noopener" class="view-all-cta">{{> "icons/instagram"}}<span>View All Posts on Instagram</span></a>
        </div>
