    {{> "newsletter"}}
    {{!--
    {{> "posts-list"}}
    {{> "tags-list"}}
    --}}


<script>
    const filterButtons = document.querySelectorAll(".filter-btn");
    const productCards = document.querySelectorAll(".product-card");
    const renderProducts = (filter) => {
        productCards.forEach(card => {
            const primaryTag = card.dataset.filter;
            if (filter === "all" || filter === primaryTag) card.classList.add("active");
        });
    };
            // Setup Filter Buttons
            const setupFilters = () => {
                filterButtons.forEach(btn => {
                    btn.addEventListener("click", () => {
                        filterButtons.forEach(b => b.classList.remove("active"));
                        productCards.forEach(c => c.classList.remove("active"));
                        btn.classList.add("active");
                        renderProducts(btn.dataset.filter);
                    });
                });
            };

            renderProducts("all");
            setupFilters();
        </script>

    {{!-- If JS isn't enabled, fallback to standard pagination --}}
    <noscript>
        <div class="ae-pagination">
            {{pagination}}
        </div>
    </noscript>
    </div>