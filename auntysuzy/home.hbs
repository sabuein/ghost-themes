<style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Georgia', serif;
            line-height: 1.6;
            color: #4a4a4a;
            background-color: #faf9f7;
        }
        .hero {
            background: linear-gradient(135deg, #8b6f47 0%, #c99a6e 100%);
            color: white;
            padding: 60px 20px;
            text-align: center;
        }
        .hero h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 60px 20px;
        }
        .shop-intro {
            text-align: center;
            margin-bottom: 50px;
        }
        .shop-intro h2 {
            font-size: 1.8em;
            color: #8b6f47;
            margin-bottom: 15px;
        }
        .categories {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 50px;
        }
        .category-card {
            background: white;
            border: 2px solid #e0ddd9;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 4px;
        }
        .category-card:hover {
            border-color: #8b6f47;
            box-shadow: 0 4px 12px rgba(139, 111, 71, 0.15);
        }
        .category-card h3 {
            color: #8b6f47;
            font-size: 1.3em;
            margin-bottom: 10px;
        }
        .category-card p {
            font-size: 0.95em;
            color: #999;
        }
        .features {
            background-color: #fffbf5;
            padding: 30px;
            border-radius: 4px;
            margin-bottom: 40px;
        }
        .features h3 {
            color: #8b6f47;
            margin-bottom: 15px;
        }
        .features ul {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-left: 0;
        }
        .features li {
            list-style: none;
            padding-left: 25px;
            position: relative;
        }
        .features li:before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #8b6f47;
            font-weight: bold;
        }
        .cta {
            background: linear-gradient(135deg, #8b6f47 0%, #c99a6e 100%);
            color: white;
            padding: 40px;
            text-align: center;
            border-radius: 4px;
            margin-top: 40px;
        }
        .cta h3 {
            font-size: 1.5em;
            margin-bottom: 15px;
        }
        .cta-button {
            background-color: white;
            color: #8b6f47;
            padding: 12px 30px;
            text-decoration: none;
            border-radius: 4px;
            font-weight: 600;
            display: inline-block;
            margin-top: 15px;
            transition: transform 0.3s ease;
        }
        .cta-button:hover {
            transform: scale(1.05);
        }
        @media (max-width: 600px) {
            .categories {
                grid-template-columns: 1fr;
            }
            .features ul {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="hero">
        <h1>Shop Aunty Suzy</h1>
        <p>Handmade products with purpose</p>
    </div>

    <div class="container">
        <div class="shop-intro">
            <h2>Browse Our Collections</h2>
            <p>Each category offers carefully curated products made with care and attention to detail.</p>
        </div>

        <div class="categories">
            <div class="category-card">
                <h3>🖼️ Art</h3>
                <p>Original artwork and creative pieces to inspire and delight.</p>
            </div>
            <div class="category-card">
                <h3>🍲 Food</h3>
                <p>Artisan food products made fresh in small batches using quality ingredients.</p>
            </div>
            <div class="category-card">
                <h3>🎨 Handicrafts</h3>
                <p>Hand-crafted items that bring beauty and warmth to your home.</p>
            </div>
            
            <div class="category-card">
                <h3>🎫 Tickets</h3>
                <p>Exclusive access to workshops, classes, and special events.</p>
            </div>
        </div>

        <div class="features">
            <h3>Why Shop With Us?</h3>
            <ul>
                <li>Handmade with genuine care</li>
                <li>Small batch, quality-focused</li>
                <li>Sustainable and ethical</li>
                <li>Personal customer service</li>
                <li>Secure payment through Snipcart</li>
                <li>14-day returns policy</li>
            </ul>
        </div>

        <div class="cta">
            <h3>Ready to Explore?</h3>
            <p>Browse our full collection of handmade products and find something special for yourself or a loved one.</p>
            <a href="#snipcart" class="cta-button">Start Shopping</a>
        </div>

        <div style="margin-top: 50px; padding: 30px; background-color: #f4f1ed; border-radius: 4px;">
            <h3 style="color: #8b6f47; margin-bottom: 15px;">Frequently Asked Questions</h3>
            <p><strong>How long do orders take?</strong><br>Orders are typically dispatched within 2-3 working days. Delivery depends on your location.</p>
            <p style="margin-top: 15px;"><strong>Do you offer international shipping?</strong><br>Currently, we ship within the UK. Contact us to enquire about international orders.</p>
            <p style="margin-top: 15px;"><strong>Can I place custom orders?</strong><br>Yes! Some items can be customised. Please contact us to discuss your specific requirements.</p>
        </div>
    </div>



<div class="gh-postfeed">
    <ul class="ae-flexy-col">
        {{#foreach posts}} {{> "item" page=../pagination.page }} {{!-- partials/card.hbs --}} {{/foreach}}
    </ul>

    {{!-- If JS isn't enabled, fallback to standard pagination --}}
    <noscript>
        <div class="ae-pagination">
            {{pagination}}
        </div>
    </noscript>
</div>