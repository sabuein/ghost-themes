{{!< default}}
<!-- home.hbs -->
    <section class="hero flexy">
        <hgroup class="flexy column">
            <p><small>Welcome to <strong>{{@site.title}}</strong>&period;</small></p>
            <p><small>{{#if @member.paid}}Thanks for becoming a paying member&comma; {{@member.firstname}}&excl; 🎉{{else if @member}}Thanks for being a member&comma; {{@member.firstname}}&excl; 🙌{{else}}You are warmly invited to join our family&hellip; 🖋{{/if}}</small></p>
            <h1>Heritage Delivered to Your Door</h1>
            <p>Experience the true taste of Palestine &mdash; authentic flavours, handcrafted treasures, and heartfelt stories. Every month, discover a beautifully curated collection celebrating culture, tradition, and the comfort of home.</p>
            <div class="flexy">
                {{^if @member}}<a href="#start-your-story-with-us" class="cta-button">Start your story with us</a>{{/if}}
                <a href="#discover-our-collections" class="cta-button">Discover our collections</a>
            </div>
        </hgroup>
        {{#if @site.cover_image}}<figure class="flexy column">
            <img src="{{img_url @site.cover_image size="l"}}" alt="Aunty Suzy Discovery Box" />
        </figure>{{/if}}
        <footer class="flexy column">
            {{> "trust-badges"}}
        </footer>
    </section>


    {{> "membership-tiers"}}

    <section id="prodcuts">
        <hgroup class="shop-intro">
            <h2 id="discover-our-collections">Discover our collections</h2>
            <p>{{@site.title}} brings you a curated range of artisanal foods, heritage-inspired crafts, and limited-edition art. Each piece is crafted with intention and sourced from independent makers who honour tradition and quality.</p>
        </hgroup>
        <div class="filters">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="art">Art</button>
            <button class="filter-btn" data-filter="food-pickles">Food & Pickles</button>
            <button class="filter-btn" data-filter="handicrafts">Handicrafts</button>
            <button class="filter-btn" data-filter="tickets">Tickets</button>
        </div>
        <!-- Existing product cards -->
        {{#get "posts" filter="tags:[art,food-pickles,handicrafts,recipes,tickets]" include="tags" order="title asc"
        limit=@config.posts_per_page}}{{#if posts}}<div class="products-grid" id="productsGrid">
            {{> "product-card"}}{{pagination}}
        </div>{{else}}
        <pre class="no-results">No results were returned from this request&period;</pre>{{/if}}{{else}}
        <pre class="loop-error">{{error}}</pre>{{/get}}
        <pre class="no-results" id="noResults"
            style="display: none;">There are no products available in this category&period;</pre>
    </section>

    {{> "features"}}
    {{> "latest-articles"}}

    <section id="instagram-widget" class="instagram-feed-widget">
        <h2>✨ Follow Us on Instagram!</h2>

