{{!< default}}
<!-- home.hbs -->
<hgroup class="hero">
    <h2>Ready to Explore?</h2>
    <p>Browse our full collection of handmade products and find something special for yourself or a loved one.</p>
    <a href="#browse-our-collections" class="cta-button">Start Shopping</a>
</hgroup>

<section id="prodcuts">
    <hgroup class="shop-intro">
        <h2 id="browse-our-collections">Browse our collections</h2>
        <p>Beautifully crafted products made with care. Supporting independent artistry and sustainable living.</p>
    </hgroup>
    <div class="filters">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="art">Art</button>
        <button class="filter-btn" data-filter="food">Food</button>
        <button class="filter-btn" data-filter="handicrafts">Handicrafts</button>
        <button class="filter-btn" data-filter="tickets">Tickets</button>
    </div>
    <!-- Existing product cards -->
    {{#get "posts" filter="tags:[art,food-pickles,handicrafts,recipes,tickets]" include="tags" order="title asc"
limit="all"}}{{#if posts}}<div class="products-grid" id="productsGrid">
        {{> "product-card"}}
    </div>{{else}}<pre class="no-results">No results were returned from this request&period;</pre>{{/if}}{{else}}<pre class="loop-error">{{error}}</pre>{{/get}}
    <pre class="no-results" id="noResults" style="display: none;">There are no products available in this category&period;</pre>
</section>
        {{> "features"}}

    
    {{> "faq"}}
    {{> "contact"}}
    {{> "newsletter"}}
{{!--
    {{> "posts-list"}}
    {{> "tags-list"}}
    {{> "tiers-list"}}
    {{> "sign-up"}}
--}}

        

        

        {{!-- If JS isn't enabled, fallback to standard pagination --}}
        <noscript>
            <div class="ae-pagination">
                {{pagination}}
            </div>
        </noscript>
    </div>