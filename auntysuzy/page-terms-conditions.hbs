<!-- page.hbs -->
{{!< default}}
{{#post}}
<article class="gh-article {{post_class}}">
    {{#match @page.show_title_and_feature_image}}
    <header class="gh-header gh-canvas">
        <h1 class="gh-title">{{title}}</h1>

        {{#if custom_excerpt}}
            <p class="gh-excerpt">{{custom_excerpt}}</p>
        {{/if}}

        {{#if feature_image}}
            <figure class="gh-feature-image">
                <img src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}
    </header>
    {{/match}}

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Georgia', serif;
            line-height: 1.6;
            color: #4a4a4a;
            background-color: #faf9f7;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 60px 20px;
        }
        h1 {
            font-size: 2.5em;
            color: #8b6f47;
            margin-bottom: 10px;
            font-weight: 600;
        }
        .last-updated {
            color: #999;
            font-size: 0.9em;
            margin-bottom: 40px;
        }
        h2 {
            font-size: 1.5em;
            color: #8b6f47;
            margin-top: 30px;
            margin-bottom: 15px;
        }
        p {
            margin-bottom: 15px;
            text-align: justify;
        }
        ul {
            margin-left: 20px;
            margin-bottom: 15px;
        }
        li {
            margin-bottom: 8px;
        }
        .highlight {
            background-color: #f4f1ed;
            padding: 20px;
            border-left: 4px solid #8b6f47;
            margin: 20px 0;
        }
    </style>

    <div class="container">
        <h1>Terms & Conditions</h1>
        <p class="last-updated">Last updated: November 2025</p>

