{{!< default}}
{{!-- https://docs.ghost.org/themes/contexts/post --}}
{{#post}}<article class="{{post_class}} post-access-{{visibility}}">
    <header class="post-header">
        <p class="post-meta">
            {{#has visibility="paid"}}<span class="premium-label">Premium</span>{{/has}}
            <time class="post-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
            <span class="bull">&bull;</span>
            {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}
        </p>
        <h1 class="post-title">{{title}}</h1>
        <p class="post-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt characters="140"}}{{/if}}</p>

        {{#if feature_image}}<figure class="post-feature-image">
            <figure>
                <img srcset="{{img_url feature_image size="s"}} 300w,
                        {{img_url feature_image size="m"}} 720w,
                        {{img_url feature_image size="l"}} 960w,
                        {{img_url feature_image size="xl"}} 1200w,
                        {{img_url feature_image size="xxl"}} 2000w"
                sizes="(max-width: 1200px) 100vw, 1200px"
                src="{{img_url feature_image size="xl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>{{/if}}
    </header>

    <div class="post-content">
        {{content}}  
    </div>

    {{#if @site.comments_enabled}}<section class="post-comments">
        <h2>Discussion</h2>
        <a href="/guides">Community guidelines</a>
        {{comment_count class="gh-card-comments"}}
        {{comments title="" count=false mode="light" saturation=80}}
    </section>{{/if}}

    <footer class="post-footer">
        <div class="post-tags">
            {{tags prefix="Tags / keywords: " separator=", "}}
        </div>

        {{#primary_tag}}<div class="primary-tag">
            <a href="{{url}}">{{name}}</a>
            {{!-- Snipcart Products Documentation: https://docs.snipcart.com/v3/setup/products --}}
      <button class="btn pc-add snipcart-add-item" type="button" title="Add to cart" data-item-id="{{id}}"
        data-item-name="{{title}}" data-item-image="{{img_url feature_image}}" data-item-description="{{excerpt}}"
        data-item-url="{{url absolute='true'}}" data-item-price="4.50" data-item-custom1-name="Container Type"
        data-item-custom1-options="Jar" data-item-weight="430">Add to cart</button>
        <div>{{/primary_tag}}
        
        {{#if authors}}<div class="post-authors">
            Written by {{#foreach authors}}<a href="{{url}}">{{name}}</a>{{/foreach}}
        </div>{{/if}}
    </footer>
</article>
<aside class="post-more">
    <div class="post-more-inner">
        <div class="post-more-next">
            {{#next_post}}<span>&LeftArrow;</span><a href="{{url}}" title="{{title}}"><h4>{{title}}</h4></a>{{/next_post}}
        </div>
        <div class="post-more-prev">
            {{#prev_post}}<a href="{{url}}" title="{{title}}">
                <h4>{{title}}</h4>
            </a><span>&RightArrow;</span>{{/prev_post}}
        </div>
    </div>
</aside>{{/post}}