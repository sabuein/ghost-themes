{
    "name": "2n1",
    "description": "A ghost theme for a UK-based holding company",
    "demo": "https://2n1.co.uk/",
    "version": "1.0.1",
    "engines": {
        "ghost": ">=6.17.0"
    },
    "license": "MIT",
    "author": {
        "name": "Salaheddin AbuEin",
        "email": "salaheddin@abuein.dev",
        "url": "https://abuein.dev/"
    },
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg",
        "mobile": "assets/screenshot-mobile.jpg"
    },
    "scripts": {
        "start": "ghost start -d C:\\Users\\sala\\my\\ghost-cms",
        "restart": "ghost restart -d ~/my/instances/ghost-en",
        "update": "ghost update -d ~/my/instances/ghost-en",
        "stop": "ghost stop -d ~/my/instances/ghost-en",
        "debug": "ghost run -D -d ~/my/instances/ghost-en",
        "log": "ghost log -d ~/my/instances/ghost-en",
        "zip": "zip -r /home/sabuein/Desktop/2n1.zip * -x *.zip /assets/labs/* .gitignore",
        "zip:win": "powershell -NoProfile -Command \"$out = Join-Path ([Environment]::GetFolderPath('Desktop')) '2n1.zip'; Get-ChildItem -Exclude node_modules,*.zip,.gitignore | Compress-Archive -DestinationPath $out -Force; Write-Host ('Created ' + $out)\"",
        "scan": "npx gscan .",
        "scan-zip": "npx gscan -z /home/sabuein/Desktop/2n1.zip",
        "scan-zip:win": "powershell -NoProfile -Command \"npx gscan -z (Join-Path ([Environment]::GetFolderPath('Desktop')) '2n1.zip')\"",
        "symlink": "ln -s /home/sabuein/my/projects/ghost-themes/2n1 ~/my/instances/ghost-en/content/themes"
    },
    "config": {
        "posts_per_page": 10,
        "card_assets": true,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 2000
            }
        }
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/sabuein/ghost-themes.git"
    },
    "bugs": "https://github.com/sabuein/ghost-themes/issues",
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "type": "module"
}