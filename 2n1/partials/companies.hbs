{{!-- Companies Section --}}
<!-- partials/companies.hbs -->
<section class="companies-section fade-in-up">
    <div class="container">
        <!-- Rapid Information Systems -->
        <div id="rapid-information-systems" class="company-detail">
            <div class="company-content">
                <div class="company-text">
                    <div class="company-header">
                        <h2>Rapid Information Systems</h2>
                        <p class="company-tagline">Data Integration &amp; Digital Transformation</p>
                    </div>

                    <div class="company-description">
                        <p>Rapid simplifies data integration and digital transformation&comma; enhancing services&comma; saving costs&comma; and providing structured data for efficiency&comma; accuracy&comma; and insights&period;</p>
                        <p>For specialised teams&comma; our unique solutions make best use of your enterprise systems&comma; allowing your organisation to do more with less&period; With Rapid&comma; your software solutions are designed to scale organically&comma; empowering you to reach new heights without limitations&period;</p>
                    </div>

                    <div class="company-features">
                        <h4>Key Capabilities</h4>
                        <ul>
                            <li>Enterprise data integration solutions</li>
                            <li>Digital transformation consulting</li>
                            <li>Scalable software architecture</li>
                            <li>Cost optimization strategies</li>
                            <li>Business intelligence and analytics</li>
                        </ul>
                    </div>

                    <div class="company-sectors">
                        <h4>Target Sectors</h4>
                        <div class="sector-tags">
                            <span class="sector-tag">Enterprise Software</span>
                            <span class="sector-tag">Data Analytics</span>
                            <span class="sector-tag">Digital Transformation</span>
                        </div>
                    </div>
                    <div class="company-url">
                        <a href="https://rapid-is.co.uk/" class="btn btn-primary" title="Website" target="_blank">Website</a>
                    </div>
                </div>
                <figure class="company-image">
                    <!-- <img src="https://placehold.co/500x400" alt="Rapid Information Systems" height="400" width="500" loading="lazy" /> -->
                    {{> "icons/rapid-information-systems"}}
                </figure>
            </div>
        </div>

        <!-- Swifton Solutions -->
        <div id="swifton-solutions" class="company-detail">
            <div class="company-content reverse">
                <div class="company-text">
                    <div class="company-header">
                        <h2>Swifton Solutions</h2>
                        <p class="company-tagline">Bespoke Software Development</p>
                    </div>

                    <div class="company-description">
                        <p>A specialist in designing and delivering bespoke software solutions tailored to the specific needs of businesses across diverse sectors&period; Our work spans manufacturing&comma; lighting&comma; healthcare&comma; recruitment&comma; and more&period;</p>
                        <p>Each solution is developed with deep integration into the client&apos;s existing workflows and systems&comma; ensuring seamless adoption and maximum value delivery&period;</p>
                    </div>

                    <div class="company-features">
                        <h4>Key Capabilities</h4>
                        <ul>
                            <li>Custom software development</li>
                            <li>System integration services</li>
                            <li>Workflow optimization</li>
                            <li>Legacy system modernization</li>
                            <li>Cross-industry expertise</li>
