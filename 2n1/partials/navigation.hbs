{{!-- Navigation --}}
<!-- partials/navigation.hbs -->
{{#if isSecondary}}<!-- Secondary Navigation -->
<ul class="flexy row secondary-nav" role="menu">
    {{#foreach navigation}}<li class="flexy row {{link_class for=(url) class=(concat 'nav-' slug)}}" role="menuitem"><a href="{{url absolute='true'}}" title="{{label}}" class="btn btn-alternative" target="_top">{{label}}</a></li>{{/foreach}}
</ul>{{else}}<!-- Mobile Menu Button -->
<button class="mobile-menu-btn" id="mobileMenuBtn">
    <span></span>
    <span></span>
    <span></span>
</button>
<!-- Side Navigation -->
<nav class="sidenav" id="sidenav">
    <div class="nav-header">
        <a href="{{@site.url}}" title="{{@site.title}} Home"><figure class="logo">
            {{> "icons/2n1"}}
        </figure></a>
        <hgroup class="logo">
            <h2>{{@site.title}}</h2>
            <p>{{@site.description}}</p>
        </hgroup>
    </div>
    <ul class="nav-menu" role="menu">
        {{!-- Loop through the navigation items --}}{{#foreach navigation}}<li><a href="{{url absolute='true'}}" class="nav-link{{#if current}} active{{/if}}" title="{{label}}" target="_top">{{label}}</a></li>{{/foreach}}{{!-- End the loop --}}
    </ul>
    <div class="nav-footer">
        <p>Made with <span class="hearts" title="unconditional love">&hearts;</span> by our team&excl;</p>
        <p>Registered in England and Wales&period;</p>
        <p>Company registration number 13862363&period;</p>
        <p>&copy; 2022 &dash; {{date format="YYYY"}} {{@site.title}} Ltd</a>&period;</p>
        <p>All Rights Reserved&period;</p>
        <p><a href="{{@site.url}}/sitemap.xml/" title="XML sitemap">XML sitemap</a></p>
    </div>
</nav>{{/if}}