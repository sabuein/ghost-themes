{{!-- Contact Form --}}
<!-- partials/form.hbs -->
<div class="contact-form-container">
    <form class="contact-form" id="contactForm" action="https://formspree.io/f/mpwllyoy" method="post" enctype="multipart/form-data">
        <h3>Send us a Message</h3>
        <div class="form-row">
            <div class="form-group">
                <label for="firstName" title="First Name">First Name *</label>
                <input type="text" id="firstName" name="firstName" required="required" autocomplete="given-name" autofocus="autofocus">
            </div>
            <div class="form-group">
                <label for="lastName" title="Last Name">Last Name *</label>
                <input type="text" id="lastName" name="lastName" required="required" autocomplete="family-name">
            </div>
        </div>
        <div class="form-group">
            <label for="email" title="Email Address">Email Address *</label>
            <input type="email" id="email" name="email" required="required" autocomplete="email">
        </div>
        <div class="form-group">
            <label for="company" title="Company Name">Company Name</label>
            <input type="text" id="company" name="company" autocomplete="organization">
        </div>
        <div class="form-group">
            <label for="role" title="Your Role">Your Role</label>
            <select id="role" name="role">
                <option value="" selected="selected" disabled="disabled">Select your role</option>
                <option value="founder">Founder/CEO</option>
                <option value="management">Management Team</option>
                <option value="advisor">Advisor/Consultant</option>
                <option value="investor">Investor</option>
                <option value="other">Other</option>
            </select>
        </div>
        <div class="form-group">
            <label for="inquiryType" title="Inquiry Type">Inquiry Type *</label>
            <select id="inquiryType" name="inquiryType" required="required">
                <option value="" selected="selected" disabled="disabled">Select inquiry type</option>
                <option value="partnership">Partnership Opportunity</option>
                <option value="acquisition">Acquisition Discussion</option>
                <option value="general">General Inquiry</option>
                <option value="portfolio">Portfolio Company Related</option>
            </select>
        </div>
        <div class="form-group">
            <label for="message" title="Message">Message *</label>
            <textarea id="message" name="message" rows="6" placeholder="Tell us about your company&comma; your goals&comma; or how we might work together&hellip;" required="required" autocomplete="off"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-large" title="Send Message">Send Message</button>
    </form>
</div>