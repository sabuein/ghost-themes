{
    "name": "greenrock",
    "description": "A simple PWA to indicate a Ghost site is under construction.",
    "demo": "https://greenrockps.com/",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=6.10.3"
    },
    "license": "MIT",
    "author": {
        "name": "Salaheddin AbuEin",
        "email": "salaheddin@abuein.dev",
        "url": "https://abuein.dev/"
    },
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg",
        "mobile": "assets/screenshot-mobile.jpg"
    },
    "scripts": {
        "start": "ghost start -d ~/my/instances/ghost-25",
        "restart": "ghost restart -d ~/my/instances/ghost-25",
        "update": "ghost update -d ~/my/instances/ghost-25",
        "stop": "ghost stop -d ~/my/instances/ghost-25",
        "debug": "ghost run -D -d ~/my/instances/ghost-25",
        "log": "ghost log -d ~/my/instances/ghost-25",
        "zip": "zip -r /home/sabuein/Desktop/greenrock.zip * -x *.zip /assets/labs/*",
        "scan": "npx gscan .",
        "scan-zip": "npx gscan -z /home/sabuein/Desktop/greenrock.zip",
        "symlink": "ln -s /home/sabuein/my/projects/ghost-themes/greenrock ~/my/instances/ghost-25/content/themes"
    },
    "config": {
        "posts_per_page": 10,
        "card_assets": true,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 2000
            }
        }
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme",
        "rtl"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/sabuein/ghost-themes.git"
    },
    "bugs": "https://github.com/sabuein/ghost-themes/issues",
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "type": "module"
}