<section id="solution" class="section-alt">
  <hgroup class="flexy-c animate-fade-up">
    <span class="text-top">المشكلة والحل</span>
    <h2>تحويل الأزمات إلى فرص واعدة</h2>
    <hr />
  </hgroup>

  <div class="grid x2">
    <div class="flexy-c grid-card animate-fade-up">
      <div class="flexy-r">
        {{> "icons/alert-triangle"}}
        <h3>المشكلة</h3>
      </div>
      <p><strong>يعاني قطاع غزة من أزمة إنسانية غير مسبوقة نتيجة&colon;</strong></p>

      <ul class="flexy-c">
        <li class="flexy-r">
          {{> "icons/home"}}
          <span>تدمير واسع النطاق للمنازل والبنية التحتية</span>
        </li>
        <li class="flexy-r">
          {{> "icons/tent"}}
          <span>اعتماد آلاف الأسر على الخيام غير الآمنة وغير الملائمة للعيش</span>
        </li>
        <li class="flexy-r">
          {{> "icons/blocks"}}
          <span>نقص حاد في مواد البناء وارتفاع تكلفتها</span>
        </li>
        <li class="flexy-r">
          {{> "icons/trash"}}
          <span>تكدّس ركام المباني المدمّرة وما يشكّله من مخاطر بيئية وصحية</span>
        </li>
      </ul>
    </div>

    <div class="flexy-c grid-card bg-primary animate-fade-up">

      <div class="flexy-r">
        {{> "icons/check"}}
        <h3>الحل</h3>
      </div>

      <p><strong>يقدّم مشروع جرين روك حلاً عملياً ومستداماً من خلال&colon;</strong></p>

      <ul class="flexy-c">
        <li class="flexy-r">
          {{> "icons/recycle"}}
          <span>إعادة تدوير ركام المباني المدمّرة</span>
        </li>
        <li class="flexy-r">
          {{> "icons/packages"}}
          <span>تحويل الركام إلى طوب بناء مبتكر</span>
        </li>
        <li class="flexy-r">
          {{> "icons/clock"}}
          <span>إنشاء وحدات سكنية مؤقتة بسرعة وكلفة أقل</span>
        </li>
        <li class="flexy-r">
          {{> "icons/shield"}}
          <span>توفير مأوى إنساني يحفظ الكرامة ويوفر الخصوصية والأمان</span>
        </li>
      </ul>
    </div>
  </div>
</section>