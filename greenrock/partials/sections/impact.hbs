<section id="impact" class="section-alt">
  <hgroup class="flexy-c animate-fade-up">
    <span>الأثر</span>
    <h2>إحداث تأثير ملموس</h2>
    <hr />
  </hgroup>

  <div class="grid x2">
    <div class="flexy-c grid-card humanitarian-impact bg-background">
      <div class="flexy-r">
        {{> "icons/hearts"}}
        <h3 className="font-heading text-2xl font-semibold text-foreground">الأثر الإنساني</h3>
      </div>

      <ul class="flexy-c">
        <li class="flexy-r">
          {{> "icons/home"}}
          <span>توفير مأوى آمن يضم غرفة ومطبخًا وحمامًا</span>
        </li>
        <li class="flexy-r">
          {{> "icons/shield"}}
          <span>تحسين مستوى الخصوصية والأمان مقارنة بالخيام</span>
        </li>
        <li class="flexy-r">
          {{> "icons/thermometer"}}
          <span>عزل حراري وصوتي أفضل</span>
        </li>
        <li class="flexy-r">
          {{> "icons/hearts"}}
          <span>تعزيز الشعور بالاستقرار والكرامة الإنسانية</span>
        </li>
      </ul>
    </div>

    <div class="flexy-c grid-card environmental-impact bg-background">
      <div class="flexy-r">
        {{> "icons/leaf"}}
        <h3 className="font-heading text-2xl font-semibold text-foreground">الأثر البيئي</h3>
      </div>

      <ul class="flexy-c">
        <li class="flexy-r">
          {{> "icons/recycle"}}
          <span>تقليل مخلفات الركام</span>
        </li>
        <li class="flexy-r">
          {{> "icons/leaf"}}
          <span>إعادة استخدام الموارد المحلية</span>
        </li>
        <li class="flexy-r">
          {{> "icons/wind"}}
          <span>خفض الانبعاثات الناتجة عن مواد البناء التقليدية</span>
        </li>
        <li class="flexy-r">
          {{> "icons/globe"}}
          <span>المساهمة في بيئة أنظف وأكثر أمانًا</span>
        </li>
      </ul>
    </div>
  </div>
</section>