<!-- ContactSection -->
<section id="contact" class="bg-gradient">
    <hgroup>
      <span>تواصل معنا</span>
      <h2>كن شريكاً لنا</h2>
      <hr />
    </hgroup>
    <div class="flexy-c">
      <p>هل ترغب في دعم المشروع أو الشراكة معنا؟ نرحب بجميع المبادرات والشراكات التي تساهم في دعم الحلول الإنسانية المستدامة.</p>

      <div class="flexy-r">
        <div class="flexy-r">
          {{> "icons/mail"}}
          <a href="mailto:contact@greenrockps.com">contact@greenrockps.com</a>
        </div>
        <div class="flexy-r">
          {{> "icons/phone"}}
          <a href="tel:+970597504063">970597504063&plus;</a>
        </div>
      </div>

      <button type="button" class="flexy-r secondary" title="تواصل معنا">
        {{> "icons/mail"}}
        <span>تواصل معنا</span>
      </button>

      <blockquote>معاً، نحوّل الدمار إلى فرصة للحياة.</blockquote>
  </div>
</section>

{{#match @site.recommendations_enabled}}<section class="recommendations">
  <hgroup>
    <h2>التوصيات</h2>
    <p>إليك بعض المواقع الأخرى التي قد تعجبك</p>
    <hr />
  </hgroup>
  {{recommendations limit="4" order="title asc"}}
</section>{{/match}}
