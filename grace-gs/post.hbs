{{#is "post"}}{{#post}}<article id="content-view" class="view active">
    {{#match @custom.show_title_and_feature_image}}<hgroup class="post-header">
        <h1 id="content-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="quote">{{custom_excerpt}}</p>{{/if}}
        <div class="post-meta">
    <span class="post-author">
        {{> "icons/events"}}<span title="By&colon;">By&colon; {{authors}}</span>
    </span>
    <time datetime="{{date published_at format='YYYY-MM-DD'}}" title="Published">
        {{> "icons/events"}}{{date published_at format="DD MMMM YYYY"}}
    </time>
    {{#match published_at "!=" updated_at}}
    <time datetime="{{date updated_at format='YYYY-MM-DD'}}" title="Updated">
        {{> "icons/events"}}Updated {{date updated_at format="DD MMMM YYYY"}}
    </time>
{{/match}}
    {{#if reading_time}}
        <span class="post-reading-time">{{reading_time}}</span>
    {{/if}}
    {{#match featured}}
        <span class="post-featured">{{> "icons/featured"}}</span>
    {{/match}}
</div>
        {{#match featured}}<p>{{> "icons/featured"}}</p>{{/match}}
        {{#if reading_time}}<p><span>{{reading_time}}</span></p>{{/if}}
    </hgroup>
    <div id="content-body">
        {{^has tag="videos"}}{{#if feature_image}}<figure class="apply-full-cover" style="{{#primary_tag}}{{#if accent_color}}--cover-color: {{accent_color}}; {{/if}}{{/primary_tag}}--cover-url: url({{img_url feature_image}});">
            <img srcset="{{img_url feature_image size='s'}} 300w, {{img_url feature_image size='m'}} 600w, {{img_url feature_image size='l'}} 1000w, {{img_url feature_image size='xl'}} 2000w" sizes="(min-width: 1400px) 1400px, 92vw" src="{{img_url feature_image size='xl'}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy" decoding="async" />
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>{{/if}}{{/has}}{{/match}}
        <div class="post-content {{post_class}}">
            {{content}}
            {{> "sharing"}}
        </div>
        {{> "cta"}}
    </div>
</article>
<div data-comments-mount>
    {{> "comments"}}
</div>
{{#contentFor "scripts"}}<script type="text/javascript">
    console.log("Hello from post.hbs!");
</script>{{/contentFor}}
{{/post}}{{/is}}