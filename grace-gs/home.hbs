{{#is "home"}}{{> "hero"}}
{{#get "posts" include="authors,tags" order="published_at desc" limit="6" as |posts pagination|}}
  <section class="container post-feed">
    <h2 class="section-title">Latest Posts</h2>
    {{#if posts}}
      <ul class="post-feed-grid post-feed-grid--standard">
        {{#foreach posts}}
          <li>{{> "card"}}</li>
        {{/foreach}}
      </ul>
    {{else}}
      <p class="loop-empty">No posts yet — check back soon.</p>
    {{/if}}
  </section>
{{else}}
  <div class="loop-error">
    <p>{{error}}</p>
  </div>
{{/get}}
