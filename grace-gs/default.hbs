<!DOCTYPE html>
<!-- default.hbs -->
<html lang="{{@site.locale}}" data-theme="dark">

<head>
    {{log this}}
    <meta charset="UTF-8" />
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta http-equiv="cleartype" content="on" />
    <meta name="description" content="{{@site.title}} &mdash; {{@site.description}}">
    <meta name="HandheldFriendly" content="True" />
    <meta name="MobileOptimized" content="320" />
    <meta name="viewport" content="user-scalable=yes, width=device-width, initial-scale=1.0, minimum-scale=1.0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="format-detection" content="telephone=no" />
    <meta http-equiv="x-rim-auto-match" content="none" />
    {{!-- Preload scripts
    <link rel="preload" href="{{asset 'js/application.mjs'}}" type="text/javascript" crossorigin="anonymous" as="script" />
    <link rel="preload" href="{{asset 'css/components/ghost.css'}}" type="text/css" as="style" />
    <link rel="preload" href="{{asset 'css/components/reset.css'}}" type="text/css" as="style" /> --}}
    <link rel="author" href="{{@site.url}}/humans.txt" type="text/plain" />
    <link rel="preload" href="{{asset 'css/screen.css'}}" type="text/css" as="style" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net/" crossorigin="anonymous" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net/" />
    <link rel="prefetch" href="https://cdn.jsdelivr.net/ghost/portal@~2.37/umd/portal.min.js" type="text/javascript" />
    <link rel="prefetch" href="https://cdn.jsdelivr.net/ghost/sodo-search@~1.1/umd/sodo-search.min.js" type="text/javascript" />
    <link rel="shortcut icon" type="image/x-icon" href="{{asset 'favicon.ico'}}" />
    <link rel="icon" type="image/x-icon" href="{{asset 'favicon.ico'}}" />
    <link rel="stylesheet" href="{{asset 'css/screen.css'}}" {{!-- hasMinFile='true' --}} type="text/css" media="all" />
    <link rel="manifest" href="/app.webmanifest" type="application/manifest+json" crossorigin="anonymous" />
    <script type="importmap">
        {
            "imports": {
                "video": "/assets/js/lib/jquery.fitvids.js",
                "helpers": "/assets/js/mods/helpers.mjs",
                "nav": "/assets/js/mods/navigation.mjs"
            }
        }
    </script>
    <title>{{@site.title}} &mdash; {{@site.description}}</title>
    {{ghost_head}}
</head>

<body class="{{body_class}}">
    <!-- ══════════════ APP SHELL ══════════════ -->
    <div id="app">
        {{> "left-nav"}}
        {{> "mobile-nav"}}
        <main id="main">
            {{{body}}}
        </main>
    </div>
    {{#if @site.secondary_navigation}}{{navigation type="secondary"}}{{/if}}
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script type="text/javascript" src="{{asset 'js/lib/jquery.fitvids.js'}}"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            // Mobile Menu Trigger
            $(".gh-burger").click(function () {
                $("body").toggleClass("gh-head-open");
            });

            console.log("Hello from default.hbs!");
        });
    </script>
    <script type="module" src="{{asset 'js/application.mjs'}}"></script>
    {{{block "scripts"}}}
    {{ghost_foot}}
</body>
</html>