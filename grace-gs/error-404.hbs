{{log "404 not found" url referrer}}

<section class="error-page container" aria-labelledby="error-heading">
  <header class="error-header">
    <p class="error-code" aria-hidden="true">
      {{statusCode}}
    </p>
    <h1 id="error-heading" class="error-description">
      {{message}}
    </h1>
    <span class="sr-only">
      HTTP status code {{statusCode}} — page not found.
    </span>
  </header>

  <div class="error-body">
    <p>
      The page you are looking for does not exist. It may have been moved,
            renamed, or removed altogether.
    </p>

    <p>
      You can head back to the
      <a href="{{@site.url}}" title="Homepage">
        homepage
      </a>
      ,
            explore our
      <a href="{{@site.url}}#products">
        products
      </a>
      , or
      <a href="{{@site.url}}#contact">
        contact us
      </a>
      if you think something is missing.
    </p>

    <div class="error-actions">
      <a href="{{@site.url}}" class="btn btn-md btn-primary" rel="home">
        Return to homepage
      </a>
      <a href="{{@site.url}}#products" class="btn btn-md btn-outline">
        Browse products
      </a>
    </div>

    {{#if errorDetails}}
      {{log "Theme error details:" errorDetails}}
      <details class="error-stack">
        <summary>
          Technical details
        </summary>
        <ul>
          {{#foreach errorDetails}}
            <li>
              <strong>
                {{{rule}}}
              </strong>
              {{#foreach failures}}
                <p>
                  Ref:
                  <code>
                    {{ref}}
                  </code>
                </p>
                <p>
                  Message: {{message}}
                </p>
              {{/foreach}}
            </li>
          {{/foreach}}
        </ul>
      </details>
    {{/if}}
  </div>
</section>