{
    "name": "grace-gs",
    "description": "Keeping public sector organisations in control since 2003",
    "version": "1.0.0",
    "private": true,
    "license": "MIT",
    "author": {
        "name": "Salaheddin AbuEin",
        "email": "salaheddin@abuein.dev",
        "url": "https://abuein.dev/"
    },
    "homepage": "https://github.com/sabuein/ghost-themes/tree/main/grace-gs#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sabuein/ghost-themes.git",
        "directory": "grace-gs"
    },
    "bugs": {
        "url": "https://github.com/sabuein/ghost-themes/issues"
    },
    "keywords": [
        "ghost",
        "ghost-theme",
        "theme",
        "pwa"
    ],
    "engines": {
        "ghost": ">=6.67.0"
    },
    "demo": "https://gracegs.com/",
    "screenshots": {
        "desktop": "assets/images/screenshots/screenshot-desktop.png",
        "mobile": "assets/images/screenshots/screenshot-mobile.png"
    },
    "config": {
        "posts_per_page": 10,
        "card_assets": true,
        "image_sizes": {
            "xxs": { "width": 30 },
            "xs": { "width": 100 },
            "s": { "width": 300 },
            "m": { "width": 600 },
            "l": { "width": 1200 },
            "xl": { "width": 2000 }
        },
        "custom": {
            "show_title_and_feature_image": {
                "type": "boolean",
                "default": true,
                "description": "Show the post title and feature image at the top of each post."
            },
            "site_layout": {
                "type": "select",
                "options": [
                    "Standard",
                    "Magazine"
                ],
                "default": "Standard",
                "description": "Choose how the homepage lays out posts."
            },
            "accent_color": {
                "type": "color",
                "default": "#84cc16",
                "description": "Primary brand colour. #84cc16"
            },
            "cta_heading": {
                "type": "text",
                "default": "Ready to Transform Your Risk Management?",
                "group": "post",
                "description": "Used in a large CTA on the homepage and small one on the sidebar as well."
            },
            "cta_text": {
                "type": "text",
                "default": "Get in touch with our team to discover how Grace Governance Solutions can help your organization achieve excellence in governance and compliance.",
                "group": "post",
                "description": "CTA text."
            },
            "cta_tel": {
                "type": "text",
                "default": "447930120661",
                "group": "post",
                "description": "Primary telephone number."
            }
        }
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "themeZip": {
        "exclude": [
            "assets/audio/**",
            "assets/files/**",
            "assets/videos/**",
            "assets/scripts/**",
            "ghost-config/**"
        ]
    },
    "scripts": {
        "start": "node ../tools/theme.mjs start",
        "stop": "node ../tools/theme.mjs stop",
        "restart": "node ../tools/theme.mjs restart",
        "debug": "node ../tools/theme.mjs debug",
        "log": "node ../tools/theme.mjs log",
        "update": "node ../tools/theme.mjs update",
        "link": "node ../tools/theme.mjs link",
        "unlink": "node ../tools/theme.mjs unlink",
        "scan": "gscan .",
        "zip": "npm run build --if-present && node ../tools/theme.mjs zip",
        "scan:zip": "npm run zip && node ../tools/theme.mjs scan-zip",
        "test": "npm run scan",
        "clean:min": "node ./assets/scripts/clean.js",
        "build:css": "node ./assets/scripts/build-css.js",
        "minify:css": "node ./assets/scripts/minify-css.js",
        "minify:css:files": "node ./assets/scripts/minify-css-files.js",
        "minify:js": "node ./assets/scripts/minify-js.js",
        "build": "npm run clean:min && npm run build:css && npm run minify:css && npm run minify:css:files && npm run minify:js"
    },
    "devDependencies": {
        "lightningcss": "^1.32.0",
        "lightningcss-cli": "^1.32.0",
        "terser": "^5.47.1"
    },
    "type": "module"
}
