{
    "name": "grace-gs",
    "description": "Keeping public sector organisations in control since 2003.",
    "demo": "https://gracegs.com/",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=6.36.0"
    },
    "license": "MIT",
    "author": {
        "name": "Salaheddin AbuEin",
        "email": "salaheddin@abuein.dev",
        "url": "https://abuein.dev/"
    },
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg",
        "mobile": "assets/screenshot-mobile.jpg"
    },
    "scripts": {
        "start": "ghost start -d ~/my/instances/ghost-25",
        "restart": "ghost restart -d ~/my/instances/ghost-25",
        "update": "ghost update -d ~/my/instances/ghost-25",
        "stop": "ghost stop -d ~/my/instances/ghost-25",
        "debug": "ghost run -D -d ~/my/instances/ghost-25",
        "log": "ghost log -d ~/my/instances/ghost-25",
        "zip": "zip -r /home/sabuein/Desktop/grace-gs.zip * -x *.zip /assets/audio/* /assets/files/* /assets/labs/* /assets/videos/* .gitignore",
        "scan": "npx gscan .",
        "scan-zip": "npx gscan -z /home/sabuein/Desktop/grace-gs.zip",
        "symlink": "ln -s /home/sabuein/my/projects/ghost-themes/grace-gs ~/my/instances/ghost-25/content/themes",
        "start-win": "ghost start -d C:/Users/sala/my/ghost-cms",
        "restart-win": "ghost restart -d C:/Users/sala/my/ghost-cms",
        "update-win": "ghost update -d C:/Users/sala/my/ghost-cms",
        "stop-win": "ghost stop -d C:/Users/sala/my/ghost-cms",
        "debug-win": "ghost run -D -d C:/Users/sala/my/ghost-cms",
        "log-win": "ghost log -d C:/Users/sala/my/ghost-cms",
        "zip-win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./assets/scripts/zip.ps1",
        "7zip-win": "7z a -tzip C:/Users/sala/Desktop/grace-gs.zip * -xr!*.zip -xr!assets/audio -xr!assets/files -xr!assets/labs -xr!assets/videos -xr!.gitignore",
        "scan-win": "npx gscan .",
        "scan-zip-win": "npx gscan -z C:/Users/sala/Desktop/grace-gs.zip",
        "symlink-win": "New-Item -ItemType SymbolicLink -Path C:/Users/sala/my/ghost-cms/content/themes/grace-gs -Target C:/Users/sala/git/ghost-themes/grace-gs"
    },
    "config": {
        "posts_per_page": 10,
        "card_assets": true,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 2000
            }
        }
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme",
        "rtl"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/sabuein/ghost-themes.git"
    },
    "bugs": "https://github.com/sabuein/ghost-themes/issues",
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "type": "module"
}