  author.hbs — Author archive page.
  Scope: author (the active author), posts (their posts), pagination.
--}}
{{#is "author"}}
{{#author}}

<header class="author-header">
  {{#if cover_image}}
    <figure class="author-cover">
      <img srcset="{{img_url cover_image size='m'}} 600w,
                   {{img_url cover_image size='l'}} 1000w,
                   {{img_url cover_image size='xl'}} 2000w"
           sizes="100vw"
           src="{{img_url cover_image size='xl'}}"
           alt=""
           loading="eager" decoding="async" fetchpriority="high" />
    </figure>
  {{/if}}

  <div class="container author-profile">
    {{#if profile_image}}
      <img class="author-avatar"
           src="{{img_url profile_image size='m'}}"
           alt="Profile photo of {{name}}"
           width="120" height="120"
           loading="eager" decoding="async" />
    {{/if}}

    <h1 class="author-name">{{name}}</h1>

    {{#if bio}}<p class="author-bio">{{bio}}</p>{{/if}}

    <dl class="author-meta">
      {{#if location}}
        <div>
          <dt class="sr-only">Location</dt>
          <dd>{{location}}</dd>
        </div>
      {{/if}}
      <div>
        <dt class="sr-only">Posts</dt>
        <dd>{{plural ../pagination.total empty='No posts yet' singular='% post' plural='% posts'}}</dd>
      </div>
    </dl>

    <ul class="author-links">
      {{#if website}}
        <li>
          <a href="{{website}}" rel="me noopener" target="_blank">
            <svg width="16" height="16" aria-hidden="true"><use href="#i-link"/></svg>
            <span>Website</span>
          </a>
        </li>
      {{/if}}
      {{#if twitter}}
        <li>
          <a href="{{social_url type="twitter"}}" rel="me noopener" target="_blank"
             aria-label="{{name}} on X / Twitter">
            <svg width="16" height="16" aria-hidden="true"><use href="#i-twitter"/></svg>
            <span>X / Twitter</span>
          </a>
        </li>
      {{/if}}
      {{#if facebook}}
        <li>
          <a href="{{social_url type="facebook"}}" rel="me noopener" target="_blank"
             aria-label="{{name}} on Facebook">
            <svg width="16" height="16" aria-hidden="true"><use href="#i-facebook"/></svg>
            <span>Facebook</span>
          </a>
        </li>
      {{/if}}
    </ul>
  </div>
</header>

{{/author}}

<section class="container author-posts">
  <h2 class="section-title">Latest from {{primary_author.name}}</h2>

  {{#if posts}}
    <ul class="post-feed-grid post-feed-grid--standard">
      {{#foreach posts}}
        <li>{{> "card"}}</li>
      {{/foreach}}
    </ul>

    {{pagination}}
  {{else}}
    <p class="loop-empty">{{primary_author.name}} hasn't published any posts yet.</p>
  {{/if}}
</section>

{{/is}}