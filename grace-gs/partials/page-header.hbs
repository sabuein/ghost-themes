{{!-- partials/page-header.hbs --}}
<hgroup class="post-header">
    <h1 id="content-title">{{title}}</h1>
    {{#if custom_excerpt}}<p class="quote">{{custom_excerpt}}</p>{{/if}}
</hgroup>
{{#if feature_image}}
    <figure class="apply-full-cover" style="{{#primary_tag}}{{#if accent_color}}--cover-color: {{accent_color}}; {{/if}}{{/primary_tag}}--cover-url: url({{img_url feature_image}});">
        <img srcset="{{img_url feature_image size='s'}} 300w,
                     {{img_url feature_image size='m'}} 600w,
                     {{img_url feature_image size='l'}} 1000w,
                     {{img_url feature_image size='xl'}} 2000w"
             sizes="(min-width: 1400px) 1400px, 92vw"
             src="{{img_url feature_image size='xl'}}"
             alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
             loading="lazy" decoding="async" />
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
{{/if}}