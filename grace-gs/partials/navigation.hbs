  Navigation — replaces Ghost's default {{navigation}} output.
  In scope: navigation (array of {label, url, current}).
  The `type` arg lets us style primary vs. secondary differently.
--}}
{{#if navigation}}
<ul class="nav-menu nav-menu--{{type}}">
  {{#foreach navigation}}
    <li class="nav-menu-item{{#if current}} is-current{{/if}}">
      <a href="{{url}}"
         {{#if current}}aria-current="page"{{/if}}
         class="nav-menu-link">
        {{label}}
      </a>
    </li>
  {{/foreach}}
</ul>
{{/if}}