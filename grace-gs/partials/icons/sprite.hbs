<svg xmlns="http://www.w3.org/2000/svg"
     style="display: none"
     aria-hidden="true"
     focusable="false">

  {{!-- Theme toggle --}}
  <symbol id="i-sun" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1"  x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22"  y1="4.22"  x2="5.64"  y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1"  y1="12" x2="3"  y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22"  y1="19.78" x2="5.64"  y2="18.36"/>
    <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
  </symbol>

  <symbol id="i-moon" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </symbol>

  {{!-- Social --}}
  <symbol id="i-linkedin" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
    <rect x="2" y="9" width="4" height="12"/>
    <circle cx="4" cy="4" r="2"/>
  </symbol>

  <symbol id="i-twitter" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
  </symbol>

  <symbol id="i-facebook" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
  </symbol>

  <symbol id="i-youtube" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
    <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
  </symbol>

  {{!-- Sharing --}}
  <symbol id="i-share" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <circle cx="18" cy="5"  r="3"/>
    <circle cx="6"  cy="12" r="3"/>
    <circle cx="18" cy="19" r="3"/>
    <line x1="8.59"  y1="13.51" x2="15.42" y2="17.49"/>
    <line x1="15.41" y1="6.51"  x2="8.59"  y2="10.49"/>
  </symbol>

  <symbol id="i-mail" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
    <polyline points="22,6 12,13 2,6"/>
  </symbol>

  <symbol id="i-link" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
  </symbol>

  {{!-- UI --}}
  <symbol id="i-check" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"/>
  </symbol>

  <symbol id="i-chevron-down" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <polyline points="6 9 12 15 18 9"/>
  </symbol>

  <symbol id="i-chevron-left" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <polyline points="15 18 9 12 15 6"/>
  </symbol>

  <symbol id="i-chevron-right" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <polyline points="9 18 15 12 9 6"/>
  </symbol>

  <symbol id="i-arrow-right" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <line x1="5" y1="12" x2="19" y2="12"/>
    <polyline points="12 5 19 12 12 19"/>
  </symbol>

  <symbol id="i-close" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <line x1="18" y1="6"  x2="6"  y2="18"/>
    <line x1="6"  y1="6"  x2="18" y2="18"/>
  </symbol>

  {{!-- Post meta --}}
  <symbol id="i-calendar" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
    <line x1="16" y1="2"  x2="16" y2="6"/>
    <line x1="8"  y1="2"  x2="8"  y2="6"/>
    <line x1="3"  y1="10" x2="21" y2="10"/>
  </symbol>

  <symbol id="i-clock" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"/>
    <polyline points="12 6 12 12 16 14"/>
  </symbol>

  <symbol id="i-star" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
  </symbol>

  {{!-- Topical (about/products/features icons) --}}
  <symbol id="i-shield" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
  </symbol>

  <symbol id="i-document" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
    <polyline points="14 2 14 8 20 8"/>
    <line x1="16" y1="13" x2="8"  y2="13"/>
    <line x1="16" y1="17" x2="8"  y2="17"/>
    <polyline points="10 9 9 9 8 9"/>
  </symbol>

  <symbol id="i-users" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
    <circle cx="8.5" cy="7" r="4"/>
    <path d="M20 8v6"/><path d="M23 11h-6"/>
  </symbol>

  <symbol id="i-activity" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
  </symbol>

  <symbol id="i-lock" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
  </symbol>

  <symbol id="i-bar-chart" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <line x1="18" y1="20" x2="18" y2="10"/>
    <line x1="12" y1="20" x2="12" y2="4"/>
    <line x1="6"  y1="20" x2="6"  y2="14"/>
  </symbol>

  <symbol id="i-grid" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
    <line x1="3" y1="9"  x2="21" y2="9"/>
    <line x1="9" y1="21" x2="9"  y2="9"/>
  </symbol>

  <symbol id="i-search" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"/>
    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
  </symbol>

  {{!-- Post status --}}
  <symbol id="i-featured" viewBox="0 0 24 24" fill="none"
          stroke="var(--color-primary)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
  </symbol>

</svg>