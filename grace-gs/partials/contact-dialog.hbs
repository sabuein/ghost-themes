<dialog id="contact-dialog" class="dialog-overlay" aria-labelledby="dialog-title">
  <article class="dialog">
    <form method="dialog" class="dialog-close-form">
      <button type="submit" class="dialog-close" aria-label="Close dialog" value="cancel">&times;</button>
    </form>
    <h2 id="dialog-title">Contact Us</h2>
    <p>Fill out the form below and we'll get back to you shortly.</p>
    <form id="contact-form" action="https://api.gracegs.com/contact"
      method="post"
      novalidate="novalidate">
      <!-- spam honeypot, hidden from humans, irresistible to bots -->
    <p class="hp" aria-hidden="true">
        <label>Leave this empty: <input type="text" name="company_url" autocomplete="off" tabindex="-1" style="position:absolute;left:-9999px;"></label>
    </p>
    <input type="hidden" name="_started" value="" />
<input type="hidden" name="_subject" value="New contact form submission {{@site.title}}" />
      <div class="form-group">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name"
               required autocomplete="name" enterkeyhint="next">
      </div>
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email"
               required autocomplete="email" inputmode="email" enterkeyhint="next">
      </div>
      <div class="form-group">
        <label for="organization">Organization</label>
        <input type="text" id="organization" name="organization"
               autocomplete="organization" enterkeyhint="next">
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="4"
                  required minlength="10" enterkeyhint="send"></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Send Message</button>
    </form>
  </article>
</dialog>