<!-- page-pwa.hbs -->
{{!< default}}
{{#post}}<section class="flexy row hero">
    {{#match @page.show_title_and_feature_image}}<hgroup class="flexy">
        <h2>{{title}}</h2>
        {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}
        <div class="hero-cta">
            <a href="#contact" class="btn primary">Discuss Your PWA Project</a>
            <a href="#benefits" class="btn secondary">Learn More</a>
        </div>
    </hgroup>
    <figure>
        {{#if feature_image}}<img src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" width="500" height="350" loading="lazy" />
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}{{else}}<img src="https://placehold.co/500x350" alt="PWA on multiple devices" width="500" height="350" loading="lazy" />{{/if}}
    </figure>{{/match}}
</section>
