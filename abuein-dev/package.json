{
    "name": "abuein-dev",
    "description": "A Ghost theme for abuein.dev, with RTL support",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "author": {
        "name": "Salaheddin AbuEin",
        "email": "salaheddin@abuein.dev",
        "url": "https://abuein.dev/"
    },
    "homepage": "https://github.com/sabuein/ghost-themes/tree/main/abuein-dev#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sabuein/ghost-themes.git",
        "directory": "abuein-dev"
    },
    "bugs": {
        "url": "https://github.com/sabuein/ghost-themes/issues"
    },
    "keywords": [
        "ghost",
        "ghost-theme",
        "theme",
        "rtl",
        "pwa"
    ],
    "engines": {
        "ghost": ">=6.67.0"
    },
    "demo": "https://abuein.dev/",
    "screenshots": {
        "desktop": "assets/images/screenshotFullScreen.png",
        "mobile": "assets/images/screenshotPhone.png"
    },
    "config": {
        "posts_per_page": 10,
        "card_assets": true,
        "image_sizes": {}
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "themeZip": {
        "exclude": [
            "assets/js/config.*"
        ]
    },
    "scripts": {
        "start": "node ../tools/theme.mjs start",
        "stop": "node ../tools/theme.mjs stop",
        "restart": "node ../tools/theme.mjs restart",
        "debug": "node ../tools/theme.mjs debug",
        "log": "node ../tools/theme.mjs log",
        "update": "node ../tools/theme.mjs update",
        "link": "node ../tools/theme.mjs link",
        "unlink": "node ../tools/theme.mjs unlink",
        "scan": "gscan .",
        "zip": "npm run build --if-present && node ../tools/theme.mjs zip",
        "scan:zip": "npm run zip && node ../tools/theme.mjs scan-zip",
        "test": "npm run scan"
    },
    "type": "module"
}
