{
    "name": "abuein-technologies",
    "description": "A theme with RTL support",
    "demo": "https://abuein.dev/",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "author": {
        "name": "Salaheddin AbuEin",
        "email": "salaheddin@abuein.dev",
        "url": "https://sabuein.github.io/"
    },
    "keywords": ["ghost-theme", "ghost-theme-rtl", "ghost-rtl", "ghost"],
    "screenshots": {
        "desktop": "assets/images/screenshot-desktop.jpg",
        "mobile": "assets/images/screenshot-mobile.jpg"
    },
    "scripts": {
        "install": "nvm install 22.13.1",
        "node": "nvm use 22.13.1",
        "ghost": "npm install ghost-cli@latest -g",
        "start": "ghost start -d ~/my/instances/ghost-25",
        "restart": "ghost restart -d ~/my/instances/ghost-25",
        "update": "ghost update -d ~/my/instances/ghost-25",
        "stop": "ghost stop -d ~/my/instances/ghost-25",
        "debug": "ghost run -D -d ~/my/instances/ghost-25",
        "log": "ghost log -d ~/my/instances/ghost-25",
        "zip": "zip -r /home/sabuein/Desktop/abuein-dev.zip * -x *.zip /assets/labs/* /assets/js/config.* .gitignore",
        "scan": "npx gscan .",
        "scan-zip": "npx gscan -z /home/sabuein/Desktop/abuein-dev.zip",
        "symlink": "ln -s /home/sabuein/my/projects/ghost-themes/abuein-dev ~/my/instances/ghost-25/content/themes",
        "build": "echo 'no build script'"
    },
    "config": {
        "posts_per_page": 10,
        "card_assets": true,
        "image_sizes": {}
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sabuein/ghost-themes.git"
    },
    "bugs": "https://github.com/sabuein/ghost-themes/issues",
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "type": "module"
}