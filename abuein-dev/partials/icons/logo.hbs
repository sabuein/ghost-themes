<svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Circular background -->
  <circle cx="100" cy="100" r="90" fill="#3a7bd5" fill-opacity="0.1"/>
  
  <!-- Stylized eye (Ein) -->
  <ellipse cx="100" cy="100" rx="50" ry="30" stroke="#3a7bd5" stroke-width="6"/>
  
  <!-- Pupil with tech circuit pattern -->
  <circle cx="100" cy="100" r="20" fill="#3a7bd5"/>
  <circle cx="100" cy="100" r="10" fill="#00d084"/>
  
  <!-- Circuit lines radiating from the eye (tech element) -->
  <path d="M40 100H60" stroke="#3a7bd5" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 4"/>
  <path d="M140 100H160" stroke="#3a7bd5" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 4"/>
  <path d="M70 60L80 80" stroke="#3a7bd5" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 4"/>
  <path d="M120 80L130 60" stroke="#3a7bd5" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 4"/>
  <path d="M70 140L80 120" stroke="#3a7bd5" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 4"/>
  <path d="M120 120L130 140" stroke="#3a7bd5" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 4"/>
  
  <!-- Protective arc above (representing Abu - father/protector) -->
  <path d="M50 70C70 40 130 40 150 70" stroke="#00d084" stroke-width="6" stroke-linecap="round"/>
  
  <!-- Small nodes representing AI/tech -->
  <circle cx="50" cy="70" r="5" fill="#00d084"/>
  <circle cx="150" cy="70" r="5" fill="#00d084"/>
  <circle cx="100" cy="45" r="5" fill="#00d084"/>
</svg>