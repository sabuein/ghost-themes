<!-- pwa-expertise.hbs -->
<section id="pwa" class="pwa">
    <hgroup class="flexy">
        <h2>PWA <span class="highlight-txt">Expertise</span></h2>
        <p>Progressive Web Applications represent the future of web development&comma; combining the best of websites and mobile apps&period; At <strong>AbuEin Technologies</strong>&comma; PWA development is our specialty&period;</p>
    </hgroup>
    <div class="container">
        <div class="pwa-content">
            <div class="pwa-text">
                <h3>Why choose a <span class="highlight-txt">PWA</span>&quest;</h3>
                <ul class="feature-list">
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>Works offline and in low network conditions</span>
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>Installable on devices without app stores</span>
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>Fast loading and responsive performance</span>
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>Push notifications for user engagement</span>
                    </li>
                    <li>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>Lower development costs than native apps</span>
                    </li>
                </ul>
                <p>Our PWAs are built with pure HTML5, CSS3, and modern JavaScript—no bloated frameworks or unnecessary dependencies.</p>
                <div class="hero-cta">
                    <a href="#contact" class="btn primary">Discuss Your PWA Project</a>
                    <a href="/pwa/#benefits" class="btn secondary">Learn More</a>
                </div>
            </div>
            
            <figure class="section-illustration">
                {{> "illustrations/progressive-app"}}
            </figure>
        </div>
    </div>
</section>