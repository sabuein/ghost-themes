{{!< default}}
<hgroup>
    <h1>An error occurred ({{statusCode}}).</h1>
    <p>This page isn't available. Sorry about that.</p>
    <p>Try searching for something else.</p>
    <p class="gh-error-description">{{message}}</p>
</hgroup>
{{#if errorDetails}}<section class="gh-error-stack">
    <h4>Theme errors:</h4>
    <ul class="gh-error-stack-list">
        {{#foreach errorDetails}}<li>
            <h2>{{{rule}}}</h2>
            {{#foreach failures}}<p><span><strong>Ref:</strong> {{ref}}</span><br><span><strong>Message:</strong> {{message}}</span></p>{{/foreach}}
        </li>{{/foreach}}
    </ul>
</section>{{/if}}

