<!-- page-careers.hbs -->
{{!< default}}

<!-- Company Introduction Section -->
<section class="careers-section company-intro animate-fade-in">
    <hgroup class="flexy">
        <h2>Join Our Team</h2>
        <p>We are a technology company specializing in building Progressive Web Apps (PWAs) and websites that deliver exceptional user experiences. Our team of experts combines creativity with technical excellence to create digital solutions that help businesses thrive in the digital world.</p>
        <div class="company-meta">
            <p><strong>Founded:</strong> 2016</p>
            <p><strong>Location:</strong> London, United Kingdom &amp; Ramallah, occupied Palestine.</p>
            <p><strong>Team Size:</strong> 5+</p>
        </div>
    </hgroup>
    <figure class="company-intro-image">
        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="AbuEin Technologies team" />
    </figure>
</section>

{{> "why-work-with-us"}}
{{> "team"}}

<!-- Open Positions Section -->
<section class="careers-section jobs-section animate-fade-in">
    <hgroup class="flexy">
        <h2>Open Positions</h2>
        <p>Explore our current job openings and find your next career opportunity.</p>
    </hgroup>
    <div class="container">
        {{!-- Always include an open application option --}}
        <div class="job-card" data-job-id="open-app">
            <div class="job-info">
                <h3 class="job-title">Open application</h3>
                <div class="job-meta">
                    <span class="job-meta-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path
                                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
                            </path>
                        </svg>
                        Remote
                    </span>
                    <span class="job-meta-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                        Full-time / Contract
                    </span>
                    <span class="job-meta-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                        Competitive
                    </span>
                </div>
                <p class="job-description">Don't see a role that fits your skills? We're always looking for talented individuals to join our team. Submit your application and we'll reach out if there's a match.</p>
                <h4>Job requirements&colon;</h4>
                <ul class="job-requirements">
                    <li>Passion for technology and innovation</li>
                    <li>Strong problem-solving skills</li>
                    <li>Excellent communication abilities</li>
                    <li>Willingness to learn and grow</li>
                </ul>
                <div class="job-tags">
                    <span class="job-tag">Open Role</span>
                    <span class="job-tag">Multiple Positions</span>
                </div>
            </div>
            <div class="job-actions">
                <button class="btn primary apply-btn" data-job-id="open-app">Apply Now</button>
            </div>
        </div>
    </div>
</section>

<!-- Application Dialog -->
<dialog class="application-dialog" id="application-dialog">
    <hgroup class="dialog-header">
        <h2 class="dialog-title" id="dialog-job-title">Apply for Position</h2>
        <button class="dialog-close" id="dialog-close" aria-label="Close dialog">&times;</button>
    </hgroup>
    <div class="dialog-body">
        <form id="application-form" novalidate>
            <input type="hidden" id="job-id-input" name="jobId" value="">

            <div class="form-row">
                <div class="form-group">
                    <label for="first-name" class="form-label">First Name *</label>
                    <input type="text" id="first-name" name="firstName" class="form-input" required>
                    <div class="form-error" id="first-name-error"></div>
                </div>
                <div class="form-group">
                    <label for="last-name" class="form-label">Last Name *</label>
                    <input type="text" id="last-name" name="lastName" class="form-input" required>
                    <div class="form-error" id="last-name-error"></div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="email" class="form-label">Email Address *</label>
                    <input type="email" id="email" name="email" class="form-input" required>
                    <div class="form-error" id="email-error"></div>
                </div>
                <div class="form-group">
                    <label for="phone" class="form-label">Phone Number</label>
                    <input type="tel" id="phone" name="phone" class="form-input">
                </div>
            </div>

            <div class="form-group">
                <label for="linkedin" class="form-label">LinkedIn Profile</label>
                <input type="url" id="linkedin" name="linkedin" class="form-input"
                    placeholder="https://www.linkedin.com/company/abuein-technologies/">
            </div>

            <div class="form-group">
                <label for="portfolio" class="form-label">Portfolio/Website</label>
                <input type="url" id="portfolio" name="portfolio" class="form-input"
                    placeholder="https://yourwebsite.com">
            </div>

            <div class="form-group">
                <label for="experience" class="form-label">Years of Experience *</label>
                <select id="experience" name="experience" class="form-select" required>
                    <option value="">Select experience</option>
                    <option value="0-1">Less than 1 year</option>
                    <option value="1-3">1-3 years</option>
                    <option value="3-5">3-5 years</option>
                    <option value="5-10">5-10 years</option>
                    <option value="10+">10+ years</option>
                </select>
                <div class="form-error" id="experience-error"></div>
            </div>

            <div class="form-group">
                <label for="cover-letter" class="form-label">Why are you interested in this position? *</label>
                <textarea id="cover-letter" name="coverLetter" class="form-textarea" required></textarea>
                <div class="form-error" id="cover-letter-error"></div>
            </div>

            <div class="form-group">
                <label class="form-label">Resume/CV *</label>
                <label for="resume" class="file-upload-label">
                    <svg class="file-upload-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <div class="file-upload-text">
                        <span id="resume-file-name">Upload your resume</span>
                        <p class="file-upload-info">PDF, DOCX or TXT (Max 5MB)</p>
                    </div>
                </label>
                <input type="file" id="resume" name="resume" class="form-file" accept=".pdf,.docx,.doc,.txt"
                    required>
                <div class="form-error" id="resume-error"></div>
                <div class="file-list" id="resume-file-list"></div>
            </div>

            <div class="form-group">
                <label class="form-label">Additional Documents</label>
                <label for="additional-docs" class="file-upload-label">
                    <svg class="file-upload-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <div class="file-upload-text">
                        <span>Upload additional documents</span>
                        <p class="file-upload-info">Portfolio, certificates, etc. (Max 10MB total)</p>
                    </div>
                </label>
                <input type="file" id="additional-docs" name="additionalDocs" class="form-file"
                    accept=".pdf,.docx,.doc,.txt,.png,.jpg,.jpeg" multiple>
                <div class="file-list" id="additional-docs-file-list"></div>
            </div>
        </form>
    </div>
    <div class="dialog-footer">
        <button class="btn btn-outline" id="cancel-application">Cancel</button>
        <button class="btn primary" id="submit-application">Submit Application</button>
    </div>
</dialog>
{{> "signup"}}
<script type="module">
    import initCareers from "/assets/js/mods/careers.mjs";
    document.addEventListener("DOMContentLoaded", initCareers);
</script>