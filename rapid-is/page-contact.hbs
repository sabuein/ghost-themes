{{!< default}}
<!-- page-contact.hbs -->
{{#is "page"}}
{{#post}}
<section class="heading palette flexy row reverse">
    {{#match @page.show_title_and_feature_image}}<hgroup class="flexy">
        <h1 id="{{slug}}" title="{{title}}">{{title}}</h1>
        <p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="51"}}&hellip;{{/if}}</p>
    </hgroup>
    {{#if feature_image}}<figure class="flexy bg-image" style="{{#primary_tag}}{{#if accent_color}}background-color: {{accent_color}}; {{/if}}{{/primary_tag}}background-image: url({{img_url feature_image absolute='true'}})">
        <img src="{{img_url feature_image absolute='true'}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" title="{{title}}" loading="lazy" onerror="this.style.display = 'none';" />
        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>{{/if}}{{/match}}
</section>
<section id="content" class="palette flexy row">
    <article class="flexy">
        {{content}}
        <section id="map" class="flexy">
            <hgroup class="flexy">
                <h2 id="on-the-map" title="On the map">On the map</h2>
                {{!-- <p>Lorem ipsum dolor sit amet consectetur, adipisicing elit. Autem dignissimos ipsa, cum laboriosam rem qui iusto.</p> --}}
            </hgroup>
            <figure class="flexy">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3035.8696227668997!2d-0.19566965!3d51.8016578!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48763b2dd43d17d1%3A0x6b44a5f14a5a9d36!2sGarden%20Court%20Business%20Centre%2C%20Garden%20Ct%2C%20Welwyn%20Garden%20City%20AL7%201BH%2C%20UK!5e1!3m2!1sen!2ses!4v1790959025504!5m2!1sen!2ses" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="Map showing our office at Garden Court Business Centre, Welwyn Garden City"></iframe>
                <figcaption class="flexy">
                    <address>Unit 11&comma; Garden Court Business Centre&comma; Tewin Road&comma; Welwyn Garden City&comma; AL7 1BH</address>
                    <span class="flexy row">Get directions on&colon;<a href="https://maps.app.goo.gl/pKrMu2Simkmg5q7u8" title="Google Maps" target="_blank" rel="noopener">Google Maps</a>&amp;<a href="https://w3w.co/trail.tree.doll" title="what3words" target="_blank" rel="noopener">what3words</a></span>
                </figcaption>
            </figure>
        </section>
    </article>
    {{> "form"}}
</section>
{{/post}}
{{/is}}