  <hgroup>
    <h2>Tags</h2>
    <p>Lorem ipsum&comma; dolor sit amet consectetur adipisicing elitem quam quibusdam repudiandae&excl;</p>
  </hgroup>
  <hr />
  {{#if tags}}{{#foreach tags}}<a href="{{url}}" title="{{name}}" target="_top">{{name}} ({{count.posts}})</a>{{/foreach}}{{else}}<pre>This Ghost instance does not have any tags yet&period;</pre>{{/if}}{{else}}<pre class="loop-error">{{error}}</pre>{{/get}}
</section>