{{#get "tags" limit=@config.posts_per_page include="count.posts" order="count.posts desc"}}<section class="loop">
  <hgroup>
    <h2>Tags</h2>
    <p>Lorem ipsum&comma; dolor sit amet consectetur adipisicing elitem quam quibusdam repudiandae&excl;</p>
  </hgroup>
  <hr />
  <div class="container">
    {{#foreach tags}}<a href="{{url}}" title="{{name}}" target="_top">{{name}} ({{count.posts}})</a>{{else}}<pre>This Ghost instance does not have any tags yet&period;</pre>{{/foreach}}{{else}}<pre class="loop-error">{{error}}</pre>{{/get}}
</section>