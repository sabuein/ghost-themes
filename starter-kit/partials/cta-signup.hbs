<!-- partials/cta-signup.hbs -->
{{!-- A signup call to action is displayed here, unless viewed as a logged-in member --}}
{{#if @site.members_enabled}}{{#unless @member}}{{#unless @site.comments_enabled}}{{#if access}}<section class="cta modal">
    <hgroup>
        <h2>Sign up to our mailing list</h2>
        <p>It is completely free&period; No spam ever&period; You can unsubscribe anytime&period;</p>
    </hgroup>
    <hr />
    <div class="container">
        <dialog open="open" aria-modal="false">
            <h3 title="Please fill out the form below">Please fill out the form below&hellip;</h3>
            {{!-- <button type="button" title="Close" autofocus="autofocus" formnovalidate="formnovalidate" aria-label="Close" value="Cancel">&cross; Close</button> --}}
            <form onsubmit="return validateForm();" action="." method="post" enctype="multipart/form-data" autocomplete="on" spellcheck="false" accept-charset="utf-8" target="_top" rel="opener" data-members-form="subscribe">
                {{> "form-validity"}}
                <fieldset>
                    <legend><h4>Subscribe to our newsletters</h4></legend>
                </fieldset>
                <fieldset>
                    <label for="cta-signup-name" title="Name"><span aria-label="required">*</span><strong>Name</strong><input type="text" name="name" id="cta-signup-name" placeholder="Your full name (e.g. Jane Doe)" autocomplete="name" pattern="^[A-Z][A-Za-z]+(?: [A-Z][A-Za-z]+)+$" maxlength="70" required="required" aria-required="true" data-members-name="" /></label>
                    <label for="cta-signup-email" title="Email"><span aria-label="required">*</span><strong>Email</strong><input type="email" name="email" id="cta-signup-email" placeholder="Your email address" autocomplete="email" pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$" minlength="8" required="required" aria-required="true" data-members-email="" /></label>
                </fieldset>
                <fieldset>
                    {{#get "newsletters"}}{{#foreach newsletters}}<label for="{{slug}}" title="{{name}}"><input type="checkbox" id="{{slug}}" value="{{name}}" checked="checked" required="required" aria-required="true" data-members-newsletter="" />{{name}}</label>{{/foreach}}{{/get}}
                    <input type="hidden" value="Early visitors" data-members-label="" />
                </fieldset>
                <fieldset class="controls">
                    <p class="required-fields" title="Required fields">Required fields</p>
                    <div>
                        <label for="cta-signup-terms-conditions" title="I have read and agreed with the terms &amp; conditions&period;"><span aria-label="required">*</span><input type="checkbox" id="cta-signup-terms-conditions" name="tandc" value="agree" required="required" aria-required="true" /><span>I have read and agreed with the <a href="/terms-and-conditions/" title="terms and conditions">terms &amp; conditions</a>&period;</span></label>
                        <div>
                            <input type="submit" value="Subscribe" title="Subscribe now" />
                            <input type="reset" value="Reset" title="Reset" />
                        </div>
                    </div>
                </fieldset>
                <pre>By using this contact form you agree to the {{@site.title}} <a href="/terms-and-conditions/" title="Terms and conditions">Terms &amp; conditions</a>&comma; and use of your details in accordance with our <a href="/privacy/" title="Privacy policy">Privacy policy</a>&period;</pre>
            </form>
        </dialog>
    </div>y
</section>{{/if}}{{/unless}}{{> "portal-links"}}{{/unless}}{{/if}}