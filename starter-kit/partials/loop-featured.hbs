<!-- partials/loop-featured.hbs -->
{{#get "posts" filter="featured:true" include="authors, tags" order="title asc, published_at desc" limit="6" as |posts|}}<section class="loop">
    <hgroup>
        <h2>Featured posts</h2>
        <p>Lorem ipsum&comma; dolor sit amet consectetur adipisicing elitem quam quibusdam repudiandae&excl;</p>
    </hgroup>
    <hr />
    {{#if posts}}{{> "loop"}}{{else}}<pre>This Ghost instance does not have any featured posts yet&period;</pre>{{/if}}
</section>{{else}}<pre class="loop-error">{{error}}</pre>{{/get}}