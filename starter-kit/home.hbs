{{!< default}}
<!-- home.hbs -->
{{#is "home"}}
<section class="hero">
  <figure class="apply-full-cover" title="{{@site.title}}" style="{{#if @site.accent_color}}--cover-color: {{@site.accent_color}}; {{/if}}--cover-url: url({{img_url @site.cover_image}})">
    {{#if @site.cover_image}}<img srcset="{{img_url @site.cover_image size='s'}} 300w, {{img_url @site.cover_image size='m'}} 600w, {{img_url @site.cover_image size='l'}} 1000w, {{img_url @site.cover_image size='xl'}} 2000w" sizes="(min-width: 1400px) 1400px, 92vw" src="{{img_url @site.cover_image size='xl'}}" alt="{{@site.title}}" loading="lazy" />{{else}}{{> "drawings/coming-soon"}}{{/if}}
  </figure>
  <hgroup>
    <h1>{{@site.title}}</h1>
    {{#if @site.description}}<p>{{@site.description}}</p>{{/if}}
    <h2>This site is under construction &mdash; and fully operational</h2>
    <p>A modern progressive web experience is live while content and features are being refined&period;</p>
    <div class="status">🟢 <strong>System status</strong>&colon; Online &bull; ⚡ <strong>Performance</strong>&colon; Optimised &bull; 📱 <strong>PWA</strong>&colon; Ready</div>
  </hgroup>
</section>
<section class="cards">
  <div class="card">
    <h3>⚡ Fast by Design</h3>
    <p>Single&dash;page architecture focused on clarity and speed&period;</p>
  </div>
  <div class="card">
    <h3>📱 Progressive Web Ready</h3>
    <p>Installable&comma; offline&dash;friendly&comma; responsive&period;</p>
  </div>
  <div class="card">
    <h3>🎨 Theme&dash;Driven</h3>
    <p>Reusable&comma; modular design system for Ghost CMS&period;</p>
  </div>
  <div class="card">
    <h3>🔐 Privacy&dash;Aware</h3>
    <p>Minimal tracking&comma; accessibility&dash;first&period;</p>
  </div>
</section>
{{> "loop-featured"}}
{{> "loop-posts"}}
{{> "loop-tags"}}
{{> "cta-signup"}}
{{> "sharing"}}
{{#match @site.recommendations_enabled}}<section class="recommendations">
    <hgroup>
      <h2>Recommendations</h2>
      <p>Lorem ipsum&comma; dolor sit amet consectetur adipisicing elitem quam quibusdam repudiandae&excl;</p>
    </hgroup>
    <hr />
    {{recommendations limit="4" order="title asc"}}
</section>{{/match}}
{{#contentFor "scripts"}}
<script type="text/javascript">
  // FitVids - Makes video embeds responsive
  $(document).ready(() => $(".gh-content").fitVids());
  console.log("Hello from home.hbs!");
</script>{{/contentFor}}
{{/is}}