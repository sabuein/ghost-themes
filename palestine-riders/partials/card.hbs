<!-- partials/card.hbs -->
{{#foreach posts}}<article class="card" data-id="{{index}}" tabindex="0" role="button" aria-label="{{title}}">
    <a href="{{url}}" title="{{title}}"><figure class="card-thumb-placeholder"{{#if feature_image}} style="--feature-image: url({{img_url feature_image}});"{{/if}}>
        {{#primary_tag}}<figcaption class="card-type-badge badge-{{slug}}"{{#if accent_color}} style="background-color: {{accent_color}};"{{/if}}>{{name}}</figcaption>{{/primary_tag}}
        {{#if feature_image}}<img srcset="{{img_url feature_image size='s'}} 300w, {{img_url feature_image size='m'}} 600w, {{img_url feature_image size='l'}} 1000w, {{img_url feature_image size='xl'}} 2000w" sizes="(min-width: 1400px) 1400px, 92vw" src="{{img_url feature_image size='xl'}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy" />{{/if}}
    </figure>
    <div class="card-body">
        {{tags prefix="<div class='card-category'>" separator="&comma;&nbsp;" autolink="false" limit="5" visibility="public" suffix="</div>"}}<!-- all / internal / public -->
        <div class="card-title">{{title}}</div>
        <div class="card-meta">
            <time datetime="{{date format='YYYY-MM-DD'}}" title="Published on">{{> "nav/events"}}{{date format="DD MMMM YYYY"}}</time>
        </div>
        <ul class="card-authors">
            {{#foreach authors}}<li>{{#if profile_image}}<a type="text/html" href="{{url}}" target="_top" title="Read more by {{name}}" aria-label="Read more by {{name}}"><img class="author-profile-image" src="{{img_url profile_image size=" xs"}}" alt="{{name}}" /></a>{{else}}<a type="text/html" href="{{url}}" target="_top" title="Read more by {{name}}" class="author-avatar author-profile-image" aria-label="Read more of {{name}}">{{> "nav/avatar"}}</a>{{/if}}</li>{{/foreach}}
        </ul>
    </div></a>
</article>{{else}}<p style="grid-column:1/-1;color:var(--text-muted);padding:40px 0;">No content here yet &mdash; check back soon 🤙</p>{{/foreach}}