<!-- partials/mobile-nav.hbs -->
<nav id="portal-buttons">
    <ul class="row-buttons">
        <li><button type="button" title="Install" id="appInstallBtn">{{> "icons/download"}}</button></li>
        <li><button type="button" title="Search" data-ghost-search="true">{{> "icons/search"}}</button></li>
        <li><button type="button" title="Account" data-portal="account">{{> "icons/user"}}</button>{{!--{{search}}--}}</li>
        <li><button type="button" title="Language" data-action="language">{{> "icons/language"}}</button></li>
        <li><button type="button" title="Dark mode" data-action="mode">{{> "icons/moon"}}</button></li>
        <li><button type="button" title="Light mode" data-action="mode" hidden="hidden" disabled="disabled">{{> "icons/sun"}}</button></li>
        <li><button type="button" title="Menu" data-action="menu" onclick="document.getElementById('sidebar').classList.toggle('open');">{{> "icons/trigram"}}</button></li>
    </ul>
</nav>