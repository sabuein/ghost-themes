<!-- partials/sharing.hbs -->
<div id="sharing-is-caring">
    <h4 title="Share this with the world"><span>&#x27A6;</span>Share this with the world&colon;</h4>
    <ul class="row-buttons">
        <li><a href="https://x.com/share?text={{encode (concat 'Check out ' title ' from ' @site.title)}}&url={{encode url}}&via=PalestineRiders&related=sabuein" onclick="window.open(this.href, 'X-Share', 'width=550,height=235'); return false;" target="_blank" rel="noopener" title="Post on X">{{> "brands/x"}}</a></li>
        <li><a href="https://www.linkedin.com/sharing/share-offsite/?url={{encode (concat url '&title=' title)}}" onclick="window.open(this.href, 'LinkedIn-Share', 'width=550,height=235'); return false;" target="_blank" rel="noopener" title="Post on LinkedIn">{{> "brands/linkedin"}}</a></li>
        <li><a href="https://api.whatsapp.com/send/?text={{encode (concat 'Check ' title ' at ' (url absolute='true'))}}&type=custom_url&app_absent=0" onclick="window.open(this.href, 'WhatsApp-Share', 'width=550,height=235'); return false;" target="_blank" title="Share on WhatsApp">{{> "brands/whatsapp"}}</a></li>
        <li><a href="http://pinterest.com/pin/create/button/?url={{encode url}}{{#if feature_image}}&media={{img_url feature_image absolute='true'}}{{/if}}&description={{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="50"}}{{/if}}" onclick="window.open(this.href, 'Pinterest-Share', 'width=550,height=235'); return false;" target="_blank" title="Pin on Pinterest">{{> "brands/pinterest"}}</a></li>
    </ul>
</div>
