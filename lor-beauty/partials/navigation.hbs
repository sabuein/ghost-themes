{{!--
    Overrides the default markup Ghost generates for {{navigation}} and
    {{navigation type="secondary"}} (called from header.hbs and footer.hbs).
    Ghost renders both primary and secondary menus through this single file —
    `isSecondary` tells us which one we're in.
--}}
{{#if isSecondary}}
    <ul class="nav-list nav-list-secondary" role="menu">
        {{#foreach navigation}}
            <li class="nav-item nav-{{slug}}{{#if current}} nav-current{{/if}}" role="menuitem">
                <a href="{{url absolute="true"}}"{{#if current}} aria-current="page"{{/if}}>{{label}}</a>
            </li>
        {{/foreach}}
    </ul>
{{else}}
    <ul class="nav-list nav-list-primary" role="menu">
        {{#foreach navigation}}
            <li class="nav-item nav-{{slug}}{{#if current}} nav-current{{/if}}" role="menuitem">
                <a href="{{url absolute="true"}}"{{#if current}} aria-current="page"{{/if}}>{{label}}</a>
            </li>
        {{/foreach}}
    </ul>
{{/if}}