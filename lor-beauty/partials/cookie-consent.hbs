<dialog id="cookie-consent" aria-labelledby="cookie-consent-title" aria-describedby="cookie-consent-desc">
    <h2 id="cookie-consent-title">We value your privacy</h2>
    <p id="cookie-consent-desc">We use cookies and similar technologies to improve your experience, marketing, analyze traffic, and (if you allow) personalize content. Learn more in our <a href="/cookie-policy" title="Cookie policy" target="_top">Cookie policy</a>.</p>
    <menu class="cookie-consent-actions">
        <button type="button" data-cookie-action="manage">Manage preferences</button>
        <button type="button" data-cookie-action="decline">Reject all</button>
        <button type="button" data-cookie-action="accept">Accept all</button>
    </menu>
</dialog>
<button type="button" title="Cookie consent" data-dialog-open="cookie-consent">Cookie consent</button>
{{#contentFor "scripts"}}
<script type="module">
    import { initCookieConsent } from "cookies";
    initCookieConsent();
</script>
{{/contentFor}}