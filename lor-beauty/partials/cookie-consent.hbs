<dialog id="cookie-consent" open="open">
    <h2>We value your privacy</h2>
    <p>We use cookies and other technologies to personalise your experience, show you ads and perform analytics. Learn more in our Privacy Policy</p>
    <form>
        <button type="button" title="Manage preferences">Manage preferences</button>
        <button type="submit" title="Accept">Accept</button>
        <button type="submit" title="Decline">Decline</button>
    </form>
</dialog>
<button type="cookie-consent" title="Cookie consent" data-dialog-open="cookie-consent">Cookie consent</button>