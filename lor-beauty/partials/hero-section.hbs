<section class="hero-section" aria-labelledby="hero-heading">
    {{#if @custom.show_hero_video}}<video class="hero-video" autoplay muted loop playsinline preload="metadata"{{#if @site.cover_image}} poster="{{img_url @site.cover_image size="l"}}"{{/if}} aria-hidden="true">
        <source src="{{asset "videos/promo.mp4"}}" type="video/mp4">
    </video>
    <div class="hero-overlay" aria-hidden="true"></div>{{else if @site.cover_image}}<figure class="hero-bg" style="--hero-cover-image: url({{img_url @site.cover_image size="xl"}})"></figure>
    <div class="hero-overlay" aria-hidden="true"></div>{{/if}}
    <hgroup>
        <h1 id="hero-heading">{{@site.title}}</h1>
        {{#if @site.description}}<p class="hero-section-tagline">{{@site.description}}</p>{{/if}}
        <a href="{{@site.url}}/shop/" class="btn btn-primary">{{t "Shop Now"}}</a>
    </hgroup>
</section>