<section class="social-proof" aria-labelledby="social-proof-heading">
    <hgroup>
        <h2 id="social-proof-heading">{{t "Customer Reviews"}}</h2>
    </hgroup>
    <ul class="testimonial-list" role="list">
        <li class="testimonial-item">
            <figure>
                <blockquote><p>Three weeks in and the dark circles I'd covered for years have genuinely faded — and it absorbs without leaving my skin greasy.</p></blockquote>
                <figcaption>&mdash; Nadia B., {{t "Verified Customer"}}</figcaption>
            </figure>
        </li>
        <li class="testimonial-item">
            <figure>
                <blockquote><p>Two drops before bed and I wake up to skin that actually looks rested. It's the step I won't skip.</p></blockquote>
                <figcaption>&mdash; Yasmin R., {{t "Verified Customer"}}</figcaption>
            </figure>
        </li>
        <li class="testimonial-item">
            <figure>
                <blockquote><p>Lightweight, barely any scent, and a little goes a long way — one bottle lasted me two months.</p></blockquote>
                <figcaption>&mdash; Layla H., {{t "Verified Customer"}}</figcaption>
            </figure>
        </li>
    </ul>
</section>