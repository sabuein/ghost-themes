{{!< default}}
<main class="tag-page container">
    <header>
        <h1>{{tag.name}}</h1>
        {{#if tag.description}}<p>{{tag.description}}</p>{{/if}}
    </header>
    <div class="post-grid">
        {{#foreach posts}}{{#has tag="product"}}{{> "product-card"}}{{else}}<article>
            <h2><a href="{{url}}">{{title}}</a></h2>
        </article>{{/has}}{{/foreach}}
    </div>
    {{pagination}}
</main>