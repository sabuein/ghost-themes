{
  "name": "lor-beauty",
  "version": "1.0.0",
  "description": "This project is a custom Ghost CMS theme for L'OR Beauty, a premium skincare brand.",
  "demo": "https://lor.beauty/",
  "engines": {
    "ghost": ">=6.52.1"
  },
  "main": "/assets/js/application.mjs",
  "screenshots": {
    "desktop": "assets/screenshot-desktop.jpg",
    "mobile": "assets/screenshot-mobile.jpg"
  },
  "scripts": {
    "start": "ghost start -d ~/my/instances/ghost-25",
    "restart": "ghost restart -d ~/my/instances/ghost-25",
    "update": "ghost update -d ~/my/instances/ghost-25",
    "stop": "ghost stop -d ~/my/instances/ghost-25",
    "debug": "ghost run -D -d ~/my/instances/ghost-25",
    "log": "ghost log -d ~/my/instances/ghost-25",
    "zip": "zip -r /home/sabuein/Desktop/lor-beauty.zip * -x *.zip /assets/audio/* /assets/files/* /assets/labs/* /assets/videos/* .gitignore",
    "scan": "npx gscan .",
    "scan-zip": "npx gscan -z /home/sabuein/Desktop/lor-beauty.zip",
    "symlink": "ln -s /home/sabuein/my/projects/ghost-themes/lor-beauty ~/my/instances/ghost-25/content/themes"
  },
  "config": {
    "posts_per_page": 10,
    "card_assets": true,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1200
      },
      "xl": {
        "width": 2000
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sabuein/ghost-themes.git"
  },
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme",
    "rtl"
  ],
  "author": {
    "name": "Salaheddin AbuEin",
    "email": "salaheddin@abuein.dev",
    "url": "https://abuein.dev/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sabuein/ghost-themes/issues"
  },
  "homepage": "https://github.com/sabuein/ghost-themes#readme",
  "gpm": {
    "type": "theme",
    "categories": [
      "Minimal",
      "Magazine"
    ]
  },
  "type": "module"
}