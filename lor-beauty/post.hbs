{{!< default}}
<main id="main-content" class="post-page container" tabindex="-1">
    {{#post}}<article class="post">
        <hgroup class="post-header">
            <h1>{{title}}</h1>
            <p class="post-meta">
                <a href="{{primary_author.url}}" rel="author">{{primary_author.name}}</a>
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
                <span>{{reading_time}}</span>
            </p>
        </hgroup>
        {{#if feature_image}}<figure class="post-feature-image">
            <img srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1200w" sizes="(max-width: 700px) 100vw, 700px" src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="eager" decoding="auto" />
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>{{/if}}
        <div class="gh-content">
            {{content}}
        </div>
        {{#if comments}}<section class="post-comments" aria-label="{{t "Comments"}}">
            {{comments}}
        </section>{{/if}}
    </article>{{/post}}
</main>