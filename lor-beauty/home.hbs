{{!--
    Homepage — page 1 only. Ghost automatically routes /page/2/ and beyond to
    index.hbs instead, so this template is free to be "the marketing page"
    rather than a generic post list.
--}}
{{!< default}}
<main class="home-page">
    {{> "hero-section"}}
    {{> "trust-strip"}}
    {{> "featured-product"}}
    {{> "why-it-works"}}
    {{> "how-to-use"}}
    {{> "social-proof"}}
    {{> "brand-story"}}
    <section class="home-latest-posts" aria-labelledby="home-latest-posts-heading">
        <hgroup>
            <h2 id="home-latest-posts-heading">{{t "Latest posts"}}</h2>
        </hgroup>
        {{#get "posts" filter="tag:-product" limit="3" as |latestPosts|}}<div class="post-list">
            {{#foreach latestPosts}}
                <article class="post-list-item">
                    <h3><a href="{{url}}">{{title}}</a></h3>
                    {{#if excerpt}}<p class="post-list-item-excerpt">{{excerpt words="24"}}</p>{{/if}}
                </article>
            {{else}}
                <p>{{t "No posts"}}</p>
            {{/foreach}}
        </div>{{/get}}
    </section>
    <section class="home-our-authors" aria-labelledby="home-latest-posts-heading">
        <hgroup>
            <h2 id="home-our-authors-heading">{{t "Our authors"}}</h2>
        </hgroup>
        <ul class="authors-list">
            {{#foreach authors}}<li>
                <h3>{{name}}</h3>
                {{#social_accounts this}}{{> "social-card"}}{{/social_accounts}}
            {{/foreach}}</li>
        </ul>
    </section>
    {{> "final-cta"}}
    {{> "cookie-consent"}}
</main>
{{#contentFor "scripts"}}<script type="text/javascript">
    console.log("Welcome to {{@site.title}} homepage!");
</script>{{/contentFor}}