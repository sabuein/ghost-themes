{{!< default}}
<main id="main-content" class="home-page" tabindex="-1">
    {{> "hero-section"}}
    {{> "trust-strip"}}
    {{> "featured-product"}}
    {{> "why-it-works"}}
    {{> "how-to-use"}}
    {{> "social-proof"}}
    {{> "brand-story"}}
    <section class="home-latest-posts" aria-labelledby="home-latest-posts-heading">
        <hgroup>
            <h2 id="home-latest-posts-heading">{{t "Latest posts"}}</h2>
            <p>{{t "Skincare rituals, ingredient deep-dives, and the science behind the glow; practical notes from our journal to help you get the most from every drop."}}</p>
        </hgroup>
        {{> "latest-posts"}}
    </section>
    <section class="home-our-authors" aria-labelledby="home-our-authors-heading">
        <hgroup>
            <h2 id="home-our-authors-heading">{{t "Our authors"}}</h2>
            <p>{{t "Meet the estheticians, formulators, and writers behind L'OR; the people who source our oil, test every batch, and share what actually works for real skin."}}</p>
        </hgroup>
        {{> "our-authors"}}
    </section>
    {{> "final-cta"}}
</main>
{{#contentFor "scripts"}}<script type="text/javascript">
    console.log("Welcome to {{@site.title}} homepage!");
</script>{{/contentFor}}