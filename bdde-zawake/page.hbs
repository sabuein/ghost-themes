{{!< default}}
<!-- page.hbs -->
{{#post}}
<article class="{{post_class}}">
    {{#match @page.show_title_and_feature_image}}
    <header>
        <h1>{{title}}</h1>
        {{#if feature_image}}<figure>
            <img srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w" sizes="(min-width: 1000px) 1000px, 92vw" src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>{{/if}}
    </header>
    {{/match}}
    <section class="gh-content">{{content}}</section>
</article>
{{/post}}